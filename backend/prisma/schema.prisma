/// RM-02C1a: provenance-only evidence of where a resource row was seen in a
/// source workbook. This is NEVER a canonical identity by itself — it never
/// automatically becomes ResourceCatalog.code, and multiple provenance rows
/// may point at the same ResourceCatalog (one resource, many source sightings).
model ResourceSourceIdentity {
  id                String @id @default(uuid()) @db.Uuid
  resourceCatalogId String @db.Uuid
  workspaceId       String @db.Uuid

  sourceSha256          String       @db.VarChar(64)
  sourceFileName        String
  parserContractVersion String
  sheetName             String
  sourceRowNumber       Int
  sourceSection         ResourceType

  sourceCodeCellAddress String?
  sourceNameCellAddress String
  sourceUnitCellAddress String?

  rawCode String?
  rawName String
  rawUnit String?

  createdAt DateTime @default(now())

  resourceCatalog ResourceCatalog @relation(fields: [resourceCatalogId], references: [id], onDelete: Restrict)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // No separate @@index([workspaceId]) — it would be a redundant prefix of
  // the composite unique index below, which Postgres can already use for
  // workspaceId-only lookups.
  @@unique([workspaceId, sourceSha256, sheetName, sourceRowNumber, parserContractVersion])
  @@index([resourceCatalogId])
  @@index([sourceSha256])
  @@map("resource_source_identities")
}

/// RM-03D1 — HOW an exact effectiveDate came to exist, which is a different
/// fact from the date itself.
///
/// A source that states only a PERIOD states no date. The Ambon Basic Price
/// evidence gives `Period = 2024` / `TA 2024` and nowhere prints a day, yet
/// BasicPrice.effectiveDate is NOT NULL because every downstream applicability
/// rule needs one. SIMPROK must therefore DERIVE an operational date — and a
/// derived date must never be readable as something the source printed.
///
/// NULL means the row predates this distinction: provenance unknown, which is
/// honest and is deliberately NOT the same as SOURCE_STATED. The absence of a
/// claim fails closed.
enum PriceEffectiveDateProvenance {
  /// The source document itself states this exact calendar date.
  SOURCE_STATED
  /// SIMPROK derived this date from a coarser source period, by a named rule.
  DERIVED_FROM_SOURCE_PERIOD
}

/// RM-03D1 — how coarse the source's stated period actually is, machine-readable.
///
/// `sourcePeriodLabel` is verbatim source text ("TA 2024") and therefore not
/// something code may reason over: a reader cannot tell from the string alone
/// whether the period is a year, a quarter or a fortnight. This column answers
/// that, so a derived date is re-derivable by machine and not only by a human
/// reading prose.
///
/// Only YEAR exists today because YEAR is the only granularity the evidence in
/// hand actually demonstrates. Inventing MONTH/QUARTER/SEMESTER now would be
/// vocabulary with no proven referent — the same false-certainty habit this
/// slice exists to close. A later migration adds a value when a source demands
/// one.
enum PriceSourcePeriodGranularity {
  YEAR
}

enum PriceSourceType {
  VENDOR_QUOTE
  MARKET_SURVEY
  REGULATION
  SYSTEM_ESTIMATE
}

enum PriceVerificationStatus {
  UNVERIFIED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  PUBLISHED
}

enum PriceSourceOrigin {
  GOVERNMENT
  SUPPLIER
  STORE
  DISTRIBUTOR
  FIELD_REPORT
  COMMUNITY_REPORT
}

enum PriceFreshnessStatus {
  CURRENT
  EXPIRING
  EXPIRED
}

/// RM-03C — OWNERSHIP / ASSET SCOPE of a Basic Price. This is the answer to
/// "WHO OWNS THIS PRICE AND WHERE MAY IT BE USED", and it is the ONLY axis
/// that answers it.
///
/// It is deliberately NOT any of the following, all of which already exist as
/// their own independent columns and must never be collapsed into this one:
///   - publication status        -> BasicPrice.status
///   - verification status       -> BasicPrice.verificationStatus
///   - where the number came from -> BasicPrice.sourceOrigin / sourceType
///   - temporal validity          -> effectiveDate / validUntil / freshnessStatus
///
/// WORKSPACE_PRIVATE  a workspace's OWN price, made or imported because the
///                    catalog has nothing suitable. Usable by its owning
///                    workspace immediately once technically valid. It needs no
///                    national publication, no verifier, no publisher, and no
///                    second human. It is NEVER called PUBLISHED, and it never
///                    enters the SIMPROK catalog review/publication queue.
/// SIMPROK_CATALOG    a curated national/general price. Reaching public
///                    eligibility still requires the unchanged internal ladder
///                    (submission -> review -> ACCEPT -> publication), i.e.
///                    status = 'PUBLISHED' AND verificationStatus = PUBLISHED.
///
/// PRIVATE_USABLE != PUBLISHED. Orthogonality is load-bearing: a
/// WORKSPACE_PRIVATE price may truthfully carry sourceOrigin = GOVERNMENT,
/// SUPPLIER, STORE, DISTRIBUTOR or FIELD_REPORT — SOURCE != REPORTER and
/// OWNERSHIP != SOURCE. There is deliberately no "PRIVATE" source family.
enum BasicPriceAssetScope {
  WORKSPACE_PRIVATE
  SIMPROK_CATALOG
}

enum PriceSubmissionStatus {
  SUBMITTED
  NEEDS_CORRECTION
  RESUBMITTED
  ACCEPTED
  UNDER_REVIEW
