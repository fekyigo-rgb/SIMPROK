model BasicPrice {
  id                          String                        @id @default(uuid()) @db.Uuid
  resourceId                  String                        @db.Uuid
  workspaceId                 String?                       @db.Uuid
  organizationId              String?                       @db.Uuid
  regionId                    String?                       @db.Uuid
  sourceSubmissionId          String?                       @unique @db.Uuid
  effectiveDate               DateTime
  /// RM-03D1 — the source's own period wording, verbatim (e.g. "TA 2024").
  /// Kept as text on purpose: normalizing it into a date is precisely the
  /// false precision `effectiveDateProvenance` exists to prevent.
  sourcePeriodLabel           String?
  /// RM-03D1 — the machine-readable granularity of that period. Required
  /// whenever the date was DERIVED, so the derivation is checkable by code and
  /// not only by a human reading the label text.
  sourcePeriodGranularity     PriceSourcePeriodGranularity?
  /// RM-03D1 — whether `effectiveDate` was stated by the source or derived by
  /// SIMPROK from a coarser period. NULL = unknown, never "stated".
  effectiveDateProvenance     PriceEffectiveDateProvenance?
  /// RM-03D1 — the NAMED rule that produced `effectiveDate` when it was
  /// DERIVED_FROM_SOURCE_PERIOD, so a reader can re-derive it rather than
  /// trust it. Meaningless for SOURCE_STATED.
  effectiveDateDerivationRule String?
  value                       Decimal                       @db.Decimal(18, 2)
  /// BP-KDN-01 — the %KDN fact of THIS price observation.
  ///
  /// Independent of `value`: PRICE ≠ KDN. Null is unknown, never a silent
  /// zero. Two BasicPrice rows for the same ResourceCatalog may lawfully
  /// carry different %KDN facts when their source/spec context differs.
  /// ResourceCatalog.tkdnValue is not this column's competitor.
  kdnPercent                  Decimal?                      @db.Decimal(5, 2)
  kdnEstablishment            BasicPriceKdnEstablishment?
  sourceType                  PriceSourceType               @default(SYSTEM_ESTIMATE)
  verificationStatus          PriceVerificationStatus       @default(UNVERIFIED)
  sourceOrigin                PriceSourceOrigin             @default(SUPPLIER)
  freshnessStatus             PriceFreshnessStatus          @default(CURRENT)
  reportedByAccountId         String?                       @db.Uuid
  reviewDate                  DateTime?
  validUntil                  DateTime?
  status                      String                        @default("UNPUBLISHED")
  /// RM-03C. Defaults to SIMPROK_CATALOG so a writer that has not been taught
  /// about private assets can never accidentally mint one — the fail-closed
  /// direction is "this belongs to the curated catalog", never "this is
  /// privately usable".
  assetScope                  BasicPriceAssetScope          @default(SIMPROK_CATALOG)
  /// RM-03C — the provenance channel a WORKSPACE_PRIVATE *origin* price must
  /// have. A private successor (BP-DETAIL-MAINT-02) may omit it and name its
  /// predecessor through `supersedesBasicPriceId` instead. A Detail-born NEW
  /// observation (BP-CHANGE-SEM-03) may omit both and set
  /// `recordsNewObservation` instead — that row does not claim the predecessor
  /// was wrong, so it must not wear a supersession pointer. CHECK I4a allows
  /// those three evidence channels only. A SIMPROK_CATALOG price may never use
  /// this channel (catalog rows reach their import row through sourceSubmission
  /// -> PriceSubmission.importRow instead). Unattributable private rows remain
  /// unrepresentable states, not merely unwritten ones.
  sourceImportRowId           String?                       @unique @db.Uuid
  /// BP-CAT-01B — the originating workspace BasicPrice this SHARED catalog row
  /// was promoted from. NULL on every row that was not produced by promotion,
  /// which is every row that existed before this field and every ordinary
  /// workspace/private row after it — the column states a fact about promoted
  /// rows only and invents nothing about anyone else.
  ///
  /// It carries THREE jobs at once, which is why no existing relation could do
  /// it: (1) provenance — `sourceSubmissionId` is `@unique` and already held by
  /// the origin, and `sourceImportRowId` is forbidden on a catalog row by
  /// `basic_prices_import_row_link_private_only_check`, so this is the ONLY
  /// honest way a shared row can name where it came from; (2) idempotency —
  /// `@unique` on a nullable column is exactly the invariant "at most ONE shared
  /// result per originating price", because PostgreSQL treats NULLs as distinct,
  /// so unlimited non-promoted rows coexist while a second promotion of the same
  /// origin is refused by the database itself; (3) history — `onDelete: Restrict`
  /// means an origin whose truth is still standing in the shared catalog cannot
  /// be deleted out from under it.
  promotedFromBasicPriceId    String?                       @unique @db.Uuid
  /// BP-CORR-01 — the already-published BasicPrice this row REPLACES as the
  /// current truth for the same logical context. NULL on every row that
  /// supersedes nothing, which is every row that existed before this field and
  /// every ordinary publication after it: an ordinary publish states a new
  /// fact, it does not correct an old one.
  ///
  /// IT IS THE ONLY NEW FACT BP-CORR-01 ADDED, and it exists because no
  /// existing relation could answer "which published Basic Price directly
  /// replaced which prior published Basic Price". `promotedFromBasicPriceId`
  /// answers a different question (which shared row restates which workspace
  /// origin) and is deliberately kept disjoint from this one by a CHECK.
  /// `BasicPriceProvenanceCorrection` answers a third (how a WORKSPACE_PRIVATE
  /// price was re-DESCRIBED) and may never move money, which is precisely the
  /// case this column exists for.
  ///
  /// HISTORY IS NEVER REWRITTEN TO CREATE IT. The predecessor is not touched,
  /// not flagged, not dated and not deleted — the successor carries the whole
  /// relationship. "Is A still current" is therefore answered by asking whether
  /// any row points AT A, never by reading a mutable column ON A.
  ///
  /// It carries three jobs, exactly as the promotion lineage above does:
  /// (1) history — the successor names its exact predecessor, so a corrected
  /// price can always be read back to what it corrected; (2) ONE CURRENT TRUTH
  /// — `@unique` on a nullable column means at most ONE successor per
  /// predecessor, so a correction chain can never fork into two competing
  /// current truths, and PostgreSQL refuses the second one rather than trusting
  /// application code to; (3) `onDelete: Restrict` — a predecessor that is
  /// still being superseded cannot be deleted out from under its successor.
  supersedesBasicPriceId      String?                       @unique @db.Uuid
  /// BP-CHANGE-SEM-03 — this private row records a later lawful observation
  /// that does NOT claim an older observation was wrong. False on every import
  /// origin, every correction successor, and every catalog row. True only on
  /// Detail-born new observations. Currentness does not hide the predecessor:
  /// both remain historically truthful on their own dates. The predecessor is
  /// named in the audit JSON, never through `supersedesBasicPriceId`.
  recordsNewObservation       Boolean                       @default(false)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  resource                       ResourceCatalog                  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  workspace                      Workspace?                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  region                         Region?                          @relation(fields: [regionId], references: [id], onDelete: Restrict)
  sourceSubmission               PriceSubmission?                 @relation(fields: [sourceSubmissionId], references: [id])
  sourceImportRow                BasicPriceImportRow?             @relation("PrivateBasicPriceProvenance", fields: [sourceImportRowId], references: [id], onDelete: Restrict)
  /// BP-CAT-01B — the origin side of the promotion lineage. RESTRICT, never
  /// CASCADE: deleting the origin of a live shared price would leave national
  /// truth with no provenance, which is the one thing promotion exists to
  /// prevent.
  promotedFrom                   BasicPrice?                      @relation("BasicPriceSharedPromotion", fields: [promotedFromBasicPriceId], references: [id], onDelete: Restrict)
  /// The reverse read: "was this workspace price already promoted, and to what".
  promotedTo                     BasicPrice?                      @relation("BasicPriceSharedPromotion")
  /// BP-CORR-01 — the predecessor side. RESTRICT, never CASCADE: deleting the
  /// price a correction was made against would leave the correction claiming to
  /// have replaced something that no longer exists.
  supersedes                     BasicPrice?                      @relation("BasicPriceSupersession", fields: [supersedesBasicPriceId], references: [id], onDelete: Restrict)
  /// THE CURRENTNESS READ, and the reason no column on the predecessor was
  /// needed: "A is still current" is answered by whether a successor pointing
  /// AT A has already taken force at `asOf`. Because `supersedesBasicPriceId`
  /// is UNIQUE this is a to-ONE relation. Catalog successors remain
  /// PUBLISHED+PUBLISHED (S2). BP-DETAIL-MAINT-02 also allows a
  /// WORKSPACE_PRIVATE UNPUBLISHED+UNVERIFIED successor, timed by its
  /// `createdAt` rather than a publication audit.
  supersededBy                   BasicPrice?                      @relation("BasicPriceSupersession")
  projectAhspResourceResolutions ProjectAhspResourceResolution[]
  publicationAudits              BasicPricePublicationAudit[]
  provenanceCorrections          BasicPriceProvenanceCorrection[]

  @@index([resourceId])
  @@index([workspaceId])
  @@index([workspaceId, organizationId])
  // RM-03C: the private eligibility branch always filters on BOTH columns
  // (strict workspace equality AND assetScope), never on either alone.
  @@index([workspaceId, assetScope])
  @@index([organizationId])
  @@index([sourceSubmissionId])
  @@index([regionId])
  @@map("basic_prices")
}

// =====================================================
// SECTION G.2: RM-02 — BASIC PRICE IMPORT FOUNDATION
// Region authority + import batch/row staging/provenance +
// publication audit. See
// docs/implementation-gates/rm02b0-design/01-RM02B0-SCHEMA-CONTRACT.md
// for the full design contract this section implements verbatim.
// =====================================================

model Region {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  basicPrices             BasicPrice[]
  priceSubmissions        PriceSubmission[]
  basicPriceImportBatches BasicPriceImportBatch[]
  projectAhspOccurrences  ProjectAhspOccurrence[]

  @@map("regions")
}

// =====================================================
// SECTION G.2: USI-01 UNIVERSAL SMART INTAKE BOUNDARY
// =====================================================

/// USI-01 LAW 3 — CHANNEL != SOURCE != ORIGIN != TRUST.
///
/// HOW BYTES REACHED SIMPROK, and nothing else. It is emphatically NOT
/// `PriceSourceOrigin` (who the price came from in the world), NOT
/// `PriceSourceType` (what kind of statement it is), and it establishes NO
/// verification, publication or trust whatsoever.
///
/// A government price list a human uploads from a laptop is USER_UPLOAD +
/// GOVERNMENT origin. A supplier's workbook arriving over the Supplier Bridge
/// is SUPPLIER_BRIDGE + SUPPLIER origin. Intake never derives one axis from the
/// other, and no channel is more trusted than another.
enum IngestionChannel {
  USER_UPLOAD
  SUPPLIER_BRIDGE
  EXTERNAL_API
  MOBILE
  GOVERNMENT_FEED
}

enum IngestionConnectorStatus {
  ACTIVE
  REVOKED
}

/// USI-01 §12 — HOW A SOURCE LOCATOR IS SPELLED.
///
/// `BasicPriceImportRow`'s four `source*CellAddress` columns hold a POSITION in
/// the source, and until USI-01 that position could only ever be a spreadsheet
/// cell reference. This column says which coordinate system a batch's rows are
/// written in, so a CSV row's "R12C6" can never be read as A1 notation and a
/// non-spreadsheet source is never given a fabricated cell address.
///
/// EXCEL_A1 is the default because it is TRUE of every row that existed before
/// this column did: every one of them came from a workbook.
enum SourceLocatorDialect {
  EXCEL_A1
  CSV_RC
}

/// USI-01 §9/§10 — WHO IS ALLOWED TO SEND SIMPROK DATA WITHOUT A BROWSER.
///
/// A connector is an IDENTITY and a PERMISSION SLIP, never a trust claim: data
/// arriving through one lands in exactly the same candidate/review lifecycle as
/// a human upload, and no connector can write a BasicPrice, a PriceSubmission
/// verification, or a publication.
///
/// SECURITY SHAPE (§9): least privilege — a connector is bound to ONE workspace
/// and acts on behalf of ONE account, so a supplier cannot reach another
/// tenant. Revocation is a status, never a delete, so a revoked connector's
/// historical provenance survives on the batches it produced. It carries NO
/// database credentials in either direction.
///
/// AUTHENTICATION IS NOT ISSUANCE. This model holds the secret's hash so the
/// boundary can fail closed; how a secret is minted, delivered and rotated is
/// an Owner decision that USI-01 deliberately did not make.
model IngestionConnector {
  id             String @id @default(uuid()) @db.Uuid
  workspaceId    String @db.Uuid
  organizationId String @db.Uuid

  displayName String
  channel     IngestionChannel

  /// SHA-256 of a high-entropy machine secret. Deliberately not a password
  /// hash: the secret is randomly generated rather than human-chosen, so key
  /// stretching buys nothing, and a per-request KDF on a bulk ingest path is a
  /// denial-of-service lever rather than a defence.
  secretHash String

  status IngestionConnectorStatus @default(ACTIVE)

  /// The account SIMPROK holds responsible for everything this connector sends.
  /// Never the connector itself — execution belongs to a User.
  actsOnBehalfOfAccountId String @db.Uuid

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  revokedAt          DateTime?
  revokedByAccountId String?   @db.Uuid

  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actsOnBehalfOf    Account                 @relation("IngestionConnectorActsOnBehalfOf", fields: [actsOnBehalfOfAccountId], references: [id], onDelete: Restrict)
  basicPriceBatches BasicPriceImportBatch[]

  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@map("ingestion_connectors")
}

enum BasicPriceImportBatchStatus {
  PREVIEWED
  READY_FOR_REVIEW
  NEEDS_REVIEW
  APPROVED_FOR_SUBMISSION
  PARTIALLY_SUBMITTED
  SUBMITTED
  REJECTED
  SUPERSEDED
}

model BasicPriceImportBatch {
  id                  String @id @default(uuid()) @db.Uuid
  workspaceId         String @db.Uuid
  organizationId      String @db.Uuid
  uploadedByAccountId String @db.Uuid

  sourceFileName        String
  sourceSha256          String
  sourceByteLength      Int
  selectedSheetName     String
  parserContractVersion String

  /// USI-01 §12 — the coordinate system this batch's row locators are written
  /// in. EXCEL_A1 is the default because it is true of every batch that existed
  /// before this column: all of them were workbooks.
  sourceLocatorDialect SourceLocatorDialect @default(EXCEL_A1)

  /// USI-01 §8 — the SOURCE'S OWN WORDING for the jurisdiction this batch was
  /// scoped to, when the source covered more than one ("SIRIMAU", "TELUK
  /// AMBON"). It is verbatim evidence, NOT a canonical Region — `regionId` is
  /// the canonical answer and only a human sets it. Null when the source spoke
  /// of exactly one place, which is every batch imported before USI-01.
  sourceRegionScopeLabel String?

  /// BP-REGION-TRUTH-07S §7 — HOW that scope was read: COLUMN (the label heads
  /// its own price column) or ROW_VALUE (the label is stated per row in a
  /// region column). Computed at intake since USI-01 and, until now, discarded
  /// at the database boundary — so a stored batch could say WHICH scope it was
  /// read under but never HOW, and the provenance could not be reconstructed.
  ///
  /// NULL MEANS UNKNOWN, NOT "NEITHER". Every batch written before this column
  /// existed keeps null, and nothing infers a kind for them from their label:
  /// the reading that knew the answer is over, and guessing it afterwards would
  /// manufacture provenance rather than record it.
  sourceRegionScopeKind String?

  /// BP-REGION-TRUTH-07S §5 — THE SOURCE'S OWN WORD PROVING THE SCOPE IS A
  /// PLACE ("KECAMATAN", "WILAYAH"), verbatim, or NULL when the source proved
  /// no geography at all.
  ///
  /// WHY A BATCH MUST CARRY THIS. "SIRIMAU | TELUK AMBON | BAGUALA" and
  /// "GROSIR | ECERAN" are the same SHAPE — distinct labels over parallel price
  /// columns — and only a word the source writes tells them apart. Without it
  /// stored, SIMPROK could not later know whether this batch's scope even had a
  /// geographic meaning to reconcile against `regionId`, and would have had to
  /// either warn about every column matrix or stay silent about all of them.
  ///
  /// IT IS EVIDENCE, NOT A CLAIM OF AGREEMENT. It never names a canonical
  /// Region, is never compared to one by spelling, and asserts nothing about
  /// whether the scope and `regionId` describe the same place — see
  /// `regionScopeConfirmedRegionId` for the only fact that settles that.
  sourceRegionScopeGeographicEvidence String?

  /// BP-REGION-TRUTH-07S §8 — WHICH canonical Region a HUMAN confirmed this
  /// geographic source scope against. NULL means nobody has.
  ///
  /// SIMPROK CANNOT PROVE THIS ITSELF, AND MUST NOT PRETEND TO. `Region` is a
  /// flat code/name table with no jurisdictional hierarchy, so there is no
  /// authoritative fact here by which "SIRIMAU" could be shown to be inside, or
  /// outside, "Kecamatan Teluk Ambon Baguala". Comparing the two spellings
  /// would be a guess wearing a proof's clothes. So the compatibility is
  /// neither asserted nor denied — it is left UNPROVEN and asked, once.
  ///
  /// STORED AS THE REGION, NOT AS A BOOLEAN, because a confirmation belongs to
  /// the fact it confirmed. A person who confirms "SIRIMAU goes with Region A"
  /// and then changes the batch to Region B has confirmed nothing about B, and
  /// a bare "confirmed" flag would silently carry the old decision onto the new
  /// region — the same shape of falsehood `effectiveDateProvenance` guards
  /// against when a date changes.
  ///
  /// DELIBERATELY NOT A FOREIGN KEY. It records WHAT WAS CONFIRMED at the time,
  /// which must stay readable as evidence even if that Region is later
  /// deactivated; a cascade or a restrict would let region housekeeping rewrite
  /// or block a human decision that was truthfully made.
  regionScopeConfirmedRegionId String? @db.Uuid

  /// USI-01R2 §5 — WHERE THIS BATCH'S ORIGINAL BYTES ARE RETAINED.
  ///
  /// LAW 2.2 requires SIMPROK to be able to answer "what exactly was received?"
  /// The bytes are kept under a content-addressed path and this is the pointer
  /// to them, alongside `sourceSha256` which identifies them.
  ///
  /// It is deliberately NOT a `SourceDocument` foreign key. Moving Basic Price
  /// arrivals onto the Reality Intake platform model is RM-12 work by name
  /// (ROADMAP.md §15: "memindahkan intake ke Platform Layer"), and DEBT.md
  /// records this intake as UTANG-PLATFORM-03 vertical-local temporary intake
  /// until that gate. Null for batches imported before bytes were retained.
  sourceStorageRef String?

  /// USI-01 LAW 3 — HOW these bytes reached SIMPROK. Independent of
  /// `sourceOrigin`/`sourceType`, which say who the price came from in the
  /// world. USER_UPLOAD is the default because it is true of every batch that
  /// existed before the Supplier Bridge did.
  ingestionChannel     IngestionChannel @default(USER_UPLOAD)
  ingestionConnectorId String?          @db.Uuid

  /// USI-01R §10 — DELIVERY IDENTITY. One HTTP request, webhook delivery,
  /// retry or transfer. It is EVIDENCE OF TRANSMISSION ONLY and is deliberately
  /// NOT a fingerprint input: re-delivering the same observation with a new
  /// request id is a retry, never a new price.
  ingestionDeliveryId String?

  /// USI-01R §10 — SOURCE OBSERVATION IDENTITY, three independent facts.
  ///
  ///   externalSourceId  WHICH external system/catalog spoke.
  ///   externalRecordId  WHICH logical item/offer/price stream it spoke about.
  ///   externalVersion   WHICH version of that stream this is.
  ///
  /// Together they are what makes a supplier's later price a NEW OBSERVATION of
  /// a known stream rather than a duplicate product identity (LAW 2.4/2.5).
  /// All three are fingerprint inputs; the delivery id above is not.
  ingestionExternalSourceId String?
  ingestionExternalRecordId String?
  ingestionExternalVersion  String?

  /// USI-01R2 §6A — THE ATOMIC SOURCE OBSERVATION KEY.
  ///
  /// One deterministic string identifying WHICH OBSERVATION of a source stream
  /// this batch is, derived from connector + externalSourceId + externalRecordId
  /// + (externalVersion, else the source's own observation time). Null when the
  /// source states no record identity at all — a human's file upload — which
  /// keeps that path on its existing bytes-and-context replay law.
  ///
  /// It exists as a COLUMN because the invariant has to be enforced by the
  /// database. A read-then-insert check cannot hold under concurrency: two
  /// simultaneous deliveries can both observe "nothing exists" and both insert.
  /// The unique index below is what makes "one observation, one fact" true
  /// rather than merely intended.
  sourceObservationKey String?

  /// USI-01R §10 — WHEN THE SOURCE SAYS IT OBSERVED THE PRICE.
  ///
  /// Emphatically not `createdAt`, which is when SIMPROK received it. A price
  /// observed on the 18th and delivered on the 25th is a 18th-of-the-month
  /// fact, and collapsing the two would silently rewrite when the world was
  /// measured. Null when the source states nothing — never back-filled from the
  /// arrival time.
  sourceObservedAt DateTime?

  regionId                    String?   @db.Uuid
  effectiveDate               DateTime?
  effectiveDateSetByAccountId String?   @db.Uuid
  effectiveDateSetAt          DateTime?

  /// RM-03D1 — the source's own period wording, verbatim (e.g. "TA 2024"), and
  /// whether `effectiveDate` was stated by the source or derived from that
  /// period by a named rule. These three travel to every BasicPrice the batch
  /// materializes, so a price is self-describing rather than requiring a reader
  /// to walk back to the import row to learn what the source actually said.
  sourcePeriodLabel           String?
  sourcePeriodGranularity     PriceSourcePeriodGranularity?
  effectiveDateProvenance     PriceEffectiveDateProvenance?
  effectiveDateDerivationRule String?

  /// SOFT RE-VERIFICATION — the date a human asked for these prices to be
  /// CHECKED AGAIN, carried here so it can travel to every BasicPrice this
  /// batch materializes (`BasicPrice.reviewDate`, which already existed and
  /// had no batch-side carrier).
  ///
  /// IT IS NOT `validUntil` AND MUST NEVER BE MAPPED TO IT. `validUntil` is a
  /// hard boundary the AHSP candidate query and the Cost Kernel actually
  /// enforce; this is advice. A price past this date stays fully usable and
  /// stays in every candidate set.
  ///
  /// NULLABLE AND NEVER DERIVED. SIMPROK does not compute a freshness horizon —
  /// no canonical policy states one — so this is null unless a person stated it,
  /// and null means "nobody said", never "expired".
  reviewDate                  DateTime?

  sourceType             PriceSourceType?
  sourceOrigin           PriceSourceOrigin?
  sourceOrganizationName String?
  sourceVendorName       String?

  priceCoverageDeclared Boolean  @default(false)
  transportIncluded     Boolean?
  loadingIncluded       Boolean?
  unloadingIncluded     Boolean?
  deliveredToProject    Boolean?

  /// SEMANTIC INTERPRETATION IDENTITY — WHICH READING PRODUCED THESE ROWS.
  ///
  /// A source whose columns carry no header, or which declares no resource
  /// families of its own, admits MORE THAN ONE LAWFUL READING of the same bytes.
  /// The Owner's workbook proved what that costs: read with its resource-name
  /// column answered as the unit column it produced 934 poisoned rows, and read
  /// honestly the identical file produced 894 truthful ones. These three columns
  /// are what let a reader ask a batch "which interpretation produced you?" and
  /// get an answer instead of an inference.
  ///
  /// THEY ARE FINGERPRINT INPUTS, which is the point: without them a corrected
  /// re-import matched the poisoned batch and was handed the poison back as a
  /// replay, so the defect could not be repaired from the outside at all.
  ///
  /// NULL MEANS "THE DOCUMENT DECIDED THIS", AND FOR OLDER BATCHES "NOT
  /// RECORDED". Nothing is back-filled. A batch imported before these columns
  /// existed states null, and SIMPROK does not reconstruct historical column
  /// roles from rows — an inferred provenance would be a fabricated one, and a
  /// fabricated provenance is worse than an absent one.
  interpretationResourceNameColumn Int?
  interpretationSourceUnitColumn   Int?
  interpretationDeclaredSection    BasicPriceImportRowSection?
  /// BP-KDN-01 — recorded ONLY when a human confirmed an ambiguous/conflict
  /// KDN heading. Null when the document proved a CLEAR heading, when KDN
  /// is absent, or when mapping still needs review. Fingerprint input only
  /// in the human-confirmed case, same law as selectedNameColumn.
  interpretationKdnColumn          Int?
  kdnMappingStatus                 BasicPriceKdnMappingStatus @default(ABSENT)
  /// Candidate KDN-like columns awaiting a human, verbatim headers. Null
  /// when mapping is ABSENT or ESTABLISHED. Never used as a KDN value.
  kdnMappingCandidates             Json?

  importFingerprint String
  status            BasicPriceImportBatchStatus @default(PREVIEWED)

  reviewedByAccountId String?   @db.Uuid
  reviewedAt          DateTime?
  rejectionReason     String?   @db.Text

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  region             Region?               @relation(fields: [regionId], references: [id], onDelete: Restrict)
  ingestionConnector IngestionConnector?   @relation(fields: [ingestionConnectorId], references: [id], onDelete: Restrict)
  rows               BasicPriceImportRow[]

  @@unique([workspaceId, importFingerprint])
  /// USI-01R2 §6B — ONE OBSERVATION, ONE FACT, ENFORCED BY THE DATABASE.
  ///
  /// Two concurrent deliveries of the same observation race to insert; exactly
  /// one wins and the loser is handed the winner rather than creating a second
  /// truth. A CHANGED payload under the same key surfaces as a conflict at this
  /// index instead of quietly becoming a rival row.
  ///
  /// PostgreSQL treats NULLs as distinct, so manual uploads — which have no
  /// observation key — are untouched by this constraint.
  @@unique([workspaceId, sourceObservationKey])
  @@index([workspaceId])
  @@index([organizationId])
  @@index([status])
  @@index([ingestionConnectorId])
  @@map("basic_price_import_batches")
}

enum BasicPriceImportRowSection {
  LABOR
  MATERIAL
  EQUIPMENT
}

/// USI-01R LAW 2.8 — WHERE A ROW'S RESOURCE FAMILY CAME FROM.
///
/// `sourceSection` drives real downstream authority: the resolution service
/// uses it as the ResourceType context for Unit Kernel lookup and for
/// ResourceCatalog type matching. A reader of that column must therefore be
/// able to tell whether the document SAID equipment, or whether a human at the
/// upload screen said it on the document's behalf.
///
/// The order below is the precedence order, strongest first. An explicit
/// per-row category in the source outranks a section title, which outranks a
/// human's blanket declaration — because the source knows its own rows and the
/// uploader is guessing about all of them at once.
enum BasicPriceImportRowSectionProvenance {
  /// The row itself carried a category the source stated (e.g. "ALAT").
  SOURCE_ROW_CATEGORY
  /// A section title above the row declared it (the RM-02 sectioned workbook).
  SOURCE_SECTION_TITLE
  /// Nothing in the source said; a human stated it for the whole batch.
  UPLOADER_DECLARED
}

enum BasicPriceImportRowCollisionType {
  NONE
  EXACT_DUPLICATE
  SAME_IDENTITY_SAME_VALUE
  SAME_IDENTITY_DIFFERENT_VALUE
  CODE_COLLISION
  NAME_COLLISION
  UNIT_COLLISION
}

enum BasicPriceImportRowResolutionStatus {
  UNRESOLVED
  RESOURCE_UNKNOWN
  RESOURCE_AMBIGUOUS
  RESOURCE_TYPE_CONFLICT
  UNIT_UNKNOWN
  UNIT_AMBIGUOUS
  UNIT_CONVERSION_REQUIRED
  RESOLVED
}

enum BasicPriceImportRowStatus {
  PARSED
  NEEDS_REVIEW
  READY_FOR_SUBMISSION
  REJECTED
  SUBMISSION_CREATED
}

model BasicPriceImportRow {
  id      String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid

  /// USI-01R LAW 2.9 — NULL means SIMPROK DOES NOT KNOW this row's resource
  /// family, and refuses to invent one. That happens when the source states a
  /// category it has no safe mapping for: guessing MATERIAL there would put a
  /// bulldozer in the materials catalog. A null row is intake evidence that can
  /// never resolve or submit until a human settles it — which is the correct
  /// outcome, not a defect. Every row written before USI-01R has a real value.
  sourceSection           BasicPriceImportRowSection?
  /// Which authority set `sourceSection`. Null only for pre-USI-01R rows.
  sourceSectionProvenance BasicPriceImportRowSectionProvenance?

  /// USI-01R LAW 2.2/CAT-06 — the source's OWN category words, verbatim, kept
  /// whether or not SIMPROK could map them. "ALAT" stays readable as "ALAT"
  /// after it has been understood as EQUIPMENT, and an unmappable category is
  /// still on the record for a human to interpret.
  rawSourceCategoryCode String?
  rawSourceCategoryName String?

  sourceRowNumber        Int
  sourceCodeCellAddress  String
  sourceNameCellAddress  String
  sourceUnitCellAddress  String
  sourcePriceCellAddress String
  /// BP-KDN-01 — KDN provenance for THIS source row. Null throughout when
  /// the batch has no established KDN column (absent or still in review).
  /// Dedicated fields, never rawSourceContext: that JSON is evidence that
  /// no calculation may read.
  sourceKdnCellAddress String?
  sourceKdnHeaderText  String?

  rawResourceCodeText String?
  rawResourceNameText String
  rawUnitText         String?

  /// USI-01 §12 — the source cell's NATIVE TYPE, as the spreadsheet reader read
  /// it (an ExcelJS ValueType). NULL means the source format has no typed cells
  /// at all — a CSV field, and later a JSON/API value. Fabricating a
  /// spreadsheet cell type for a source that never had one is exactly the lie
  /// §12 forbids, so the column became nullable rather than the readers
  /// becoming liars. Every row written before USI-01 still carries its real
  /// Excel type, and nothing about them changed.
  rawPriceCellType                    Int?
  rawPriceNumericRoundTripString      String?
  rawPriceTextValue                   String?
  rawPriceFormulaText                 String?
  rawPriceCachedResultRoundTripString String?
  rawPriceFormulaError                String?
  rawPriceNumberFormat                String?
  rawPriceDisplayText                 String?

  /// USI-01 LAW 2 — RAW TRUTH NEVER DISAPPEARS. Every source column this row's
  /// dedicated fields do not already hold, kept verbatim and keyed by the
  /// source's OWN header text: the other jurisdictions' figures in a regional
  /// matrix, a preparer's `simprok_unit_candidate`, a provenance note, a
  /// source-language label. Without it, importing a wide real-world table would
  /// silently discard most of what the source actually said.
  ///
  /// It is EVIDENCE, never input to any calculation. Nothing downstream reads a
  /// price, a unit or an identity out of here.
  rawSourceContext Json?

  proposedCanonicalPrice Decimal? @db.Decimal(18, 2)
  canonicalRoundingMode  String?
  /// Exact canonical %KDN (`Decimal(5, 2)`), or null when unknown/invalid.
  /// Invalid values keep their raw text and a `kdnReasonCode`; they never
  /// become 0.00 and never block an otherwise lawful price.
  proposedCanonicalKdn   Decimal? @db.Decimal(5, 2)
  rawKdnTextValue        String?
  rawKdnNumericRoundTripString String?
  rawKdnDisplayText      String?
  kdnReasonCode          String?

  resourceCatalogId    String?       @db.Uuid
  resolvedResourceType ResourceType?
  unitDefinitionId     String?       @db.Uuid

  collisionType    BasicPriceImportRowCollisionType @default(NONE)
  collisionOfRowId String?                          @db.Uuid

  resolutionStatus BasicPriceImportRowResolutionStatus @default(UNRESOLVED)
  reasonCodes      String[]

  status BasicPriceImportRowStatus @default(PARSED)

  resolvedByAccountId String?   @db.Uuid
  resolvedAt          DateTime?

  effectiveDateOverride DateTime?

  priceSubmissionId String? @unique @db.Uuid

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch             BasicPriceImportBatch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  resourceCatalog   ResourceCatalog?                     @relation(fields: [resourceCatalogId], references: [id], onDelete: Restrict)
  unitDefinition    UnitDefinition?                      @relation(fields: [unitDefinitionId], references: [id], onDelete: Restrict)
  priceSubmission   PriceSubmission?                     @relation(fields: [priceSubmissionId], references: [id], onDelete: Restrict)
  /// RM-03C: at most one workspace-private BasicPrice may ever be materialized
  /// from a given import row (enforced by the @unique on the owning side), so
  /// re-running the private writer is idempotent rather than duplicating a fact.
  /// This is INDEPENDENT of priceSubmissionId — a row may be kept private AND
  /// later proposed to the SIMPROK catalog; neither invalidates the other.
  privateBasicPrice BasicPrice?                          @relation("PrivateBasicPriceProvenance")
  collisionOfRow    BasicPriceImportRow?                 @relation("RowCollision", fields: [collisionOfRowId], references: [id], onDelete: SetNull)
  collidingRows     BasicPriceImportRow[]                @relation("RowCollision")
  resourceMappings  BasicPriceImportRowResourceMapping[]

  @@unique([batchId, sourceRowNumber])
  @@index([batchId])
  @@index([status])
  @@index([resolutionStatus])
  @@index([resourceCatalogId])
  @@map("basic_price_import_rows")
}

/// RM-02D1: append-only audit trail of every human "resource identity
/// mapping" decision made on a BasicPriceImportRow — who mapped it to which
/// ResourceCatalog/UnitDefinition, when, why, and whether a normalized-name
/// candidate suggestion informed the pick. This is NEVER the row's current
/// state (that stays on BasicPriceImportRow itself, mutable, one row per
/// row) — it is history: a row can accumulate more than one entry if a
/// resolve attempt collides and is retried. Never updated after creation.
/// Priority order (highest confidence first, enforced in
/// BasicPriceRowResolutionService, never by this enum's declaration order
/// alone): SOURCE_ROW_PROVENANCE > NORMALIZED_NAME_SINGLE_CANDIDATE >
/// NORMALIZED_NAME_MULTIPLE_CANDIDATES > MANUAL_SEARCH.
/// PROVENANCE_NAME_CONFLICT is a distinct case, not a priority level: it
/// means the row-identity-provenance signal and the normalized-name signal
/// pointed at two DIFFERENT ResourceCatalog rows. When that happens both
/// are surfaced to the reviewer (never silently reconciled), and any
/// resolve decided while that conflict was live is tagged
/// PROVENANCE_NAME_CONFLICT regardless of which side the human picked, so
/// the audit trail can always find every row where the two signals
/// disagreed.
enum BasicPriceImportRowMappingSuggestionSource {
  MANUAL_SEARCH
  NORMALIZED_NAME_SINGLE_CANDIDATE
  NORMALIZED_NAME_MULTIPLE_CANDIDATES
  SOURCE_ROW_PROVENANCE
  PROVENANCE_NAME_CONFLICT
}

model BasicPriceImportRowResourceMapping {
  id                       String                                     @id @default(uuid()) @db.Uuid
  workspaceId              String                                     @db.Uuid
  rowId                    String                                     @db.Uuid
  resourceCatalogId        String                                     @db.Uuid
  unitDefinitionId         String                                     @db.Uuid
  reviewerAccountId        String                                     @db.Uuid
  reason                   String?                                    @db.Text
  suggestionSource         BasicPriceImportRowMappingSuggestionSource
  candidateCountAtDecision Int
  decidedAt                DateTime                                   @default(now())

  row             BasicPriceImportRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  resourceCatalog ResourceCatalog     @relation(fields: [resourceCatalogId], references: [id], onDelete: Restrict)
  unitDefinition  UnitDefinition      @relation(fields: [unitDefinitionId], references: [id], onDelete: Restrict)
  reviewer        Account             @relation("BasicPriceImportRowResourceMappingReviewer", fields: [reviewerAccountId], references: [id], onDelete: Restrict, map: "fk_row_mapping_reviewer")

  @@index([rowId])
  @@index([resourceCatalogId])
  @@index([workspaceId])
  @@index([reviewerAccountId])
  @@map("basic_price_import_row_resource_mappings")
}

/// RM-02D1-REMEDIATION-V3.1: the ONLY authority that lets
/// SOURCE_ROW_PROVENANCE cross from one source workbook hash to another. A
/// batch's own sourceSha256 (e.g. the Owner's real upload) never
/// automatically inherits ResourceSourceIdentity provenance recorded under
/// a different sourceSha256 (e.g. the RM-02C0 canonical bootstrap workbook)
/// — that would be exactly the auto-merge this project forbids. This
/// record is the explicit, human-verified, evidence-backed exception: it
/// says "a human compared these two source hashes' parsed content and
/// confirmed <evidence>," and only once such a record exists for a given
/// (workspaceId, batchSourceSha256) does BasicPriceRowResolutionService's
/// provenance lookup do anything at all. Zero records for a given batch
/// hash means zero provenance candidates for that hash — fail-closed, not
/// fail-open.
model BasicPriceSourceEquivalence {
  id                    String   @id @default(uuid()) @db.Uuid
  workspaceId           String   @db.Uuid
  batchSourceSha256     String   @db.VarChar(64)
  canonicalSourceSha256 String   @db.VarChar(64)
  evidence              String
  comparedFields        String[]
  verifiedByAccountId   String   @db.Uuid
  verifiedAt            DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  verifiedBy Account   @relation("BasicPriceSourceEquivalenceVerifiedBy", fields: [verifiedByAccountId], references: [id], onDelete: Restrict, map: "fk_equivalence_verified_by")

  @@unique([workspaceId, batchSourceSha256])
  @@index([workspaceId])
  @@index([verifiedByAccountId])
  @@map("basic_price_source_equivalences")
}

/// PR57 Gap B: actorAccountId has real Account referential integrity — the
/// FK is RESTRICT on delete (a historical publication audit row may never
/// be silently orphaned or cascaded away by deleting the Account that once
/// acted) and the relation is named explicitly (BasicPricePublicationAuditActor)
/// so it is unambiguous from every other Account relation. Suspending or
/// deactivating the Account after publication does not touch this row —
/// the FK only proves the Account still EXISTS, never that it is still
/// ACTIVE; re-authorizing a historical actor is deliberately not this
/// constraint's job.
/// RM-03D1 — append-only record of a provenance correction applied to an
/// already-existing WORKSPACE_PRIVATE BasicPrice.
///
/// WHY A TABLE AND NOT A SILENT UPDATE. Correcting `sourceType` from a guess to
/// the evidence-supported value, or restating an effectiveDate as explicitly
/// derived, changes what a persisted business fact claims. Overwriting it in
/// place would erase the claim SIMPROK previously made, and "history preserved"
/// is not satisfied by a newer value alone — a reader must be able to see that
/// the row once said something else, who changed it, and why.
///
/// This is NOT a publication record and never touches the publication ladder:
/// `status`, `verificationStatus` and `assetScope` are outside what a
/// correction may alter, so a correction can never make a private price look
/// published or verified.
model BasicPriceProvenanceCorrection {
  id             String   @id @default(uuid()) @db.Uuid
  basicPriceId   String   @db.Uuid
  workspaceId    String   @db.Uuid
  actorAccountId String   @db.Uuid
  /// Required. A correction to a money-adjacent provenance fact is never
  /// self-evident, and the audit trail must carry the human's stated reason.
  reason         String   @db.Text
  /// Exactly the correctable fields as they stood before and after, so the
  /// change is re-readable without diffing against a guess.
  before         Json
  after          Json
  createdAt      DateTime @default(now())

  basicPrice BasicPrice @relation(fields: [basicPriceId], references: [id], onDelete: Cascade)
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      Account    @relation("BasicPriceProvenanceCorrectionActor", fields: [actorAccountId], references: [id], onDelete: Restrict, map: "fk_basic_price_provenance_correction_actor")

  @@index([basicPriceId])
  @@index([workspaceId])
  @@index([actorAccountId])
  @@map("basic_price_provenance_corrections")
}

model BasicPricePublicationAudit {
  id             String   @id @default(uuid()) @db.Uuid
  basicPriceId   String   @db.Uuid
  action         String
  actorAccountId String   @db.Uuid
  reason         String?  @db.Text
  createdAt      DateTime @default(now())
  /// BP-CORR-01B TEMPORAL — WHEN THIS GOVERNED EVENT BECAME TRUE, which is not
  /// the same fact as `createdAt`.
  ///
  ///   createdAt    WHEN SIMPROK LEARNED IT. Bookkeeping. Always now().
  ///   effectiveAt  WHEN IT BECAME TRUE in the world. A business fact, which a
  ///                source may state as earlier OR later than the moment we
  ///                were told.
  ///
  /// They coincide often enough that conflating them looks harmless, and it is
  /// not. A supplier who retracts their July list "effective 1 August", handled
  /// on 5 August, would otherwise keep selling a withdrawn price for four days;
  /// a retraction announced today and effective next Monday would otherwise
  /// remove the price today. `asOf` is compared against THIS column, never
  /// against `createdAt`.
  ///
  /// NULLABLE, because it is meaningless for the two actions that already
  /// existed: a PUBLISH and a SUPERSEDED are instantaneous governance
  /// transitions that become true exactly when they are recorded, and back-
  /// filling a value onto historical rows would invent a fact nobody stated.
  /// A CHECK makes it MANDATORY for WITHDRAWN specifically, so the one action
  /// whose currentness depends on it can never be written without it.
  effectiveAt    DateTime?

  basicPrice BasicPrice @relation(fields: [basicPriceId], references: [id], onDelete: Cascade)
  actor      Account    @relation("BasicPricePublicationAuditActor", fields: [actorAccountId], references: [id], onDelete: Restrict, map: "fk_basic_price_publication_audit_actor")

  @@index([basicPriceId])
  @@index([actorAccountId])
  @@map("basic_price_publication_audits")
}

// =====================================================
// SECTION G1: BP-AHSP PHASE 2 — PROJECT AHSP OCCURRENCE
// Bounded technical/project-context container for one
// deterministic AHSP resource price-resolution attempt.
// ProjectAhspOccurrence != canonical WorkOccurrence.
// =====================================================

enum ProjectAhspResolutionStatus {
  RESOLVED
  UNRESOLVED
  NEEDS_REVIEW
}

enum ProjectAhspSelectionMode {
  AUTO_SELECTED
  USER_OVERRIDDEN
}

enum ProjectAhspResolutionMethod {
  EXACT_DETERMINISTIC
  DETERMINISTIC_ATTEMPTED
}

model ProjectAhspOccurrence {
  id                           String         @id @default(uuid()) @db.Uuid
  workspaceId                  String         @db.Uuid
  projectId                    String         @db.Uuid
  ahspVersionId                String         @db.Uuid
  idempotencyKey               String
  createdByAccountId           String?        @db.Uuid
  businessPricingAsOfDate      DateTime?      @db.Date
  referenceRegionId            String?        @db.Uuid
  resolutionPolicyVersion      String?
  requestPayloadHash           String?
  generation                   Int            @default(1)
  previousOccurrenceId         String?        @db.Uuid
  resolutionContentFingerprint String?
  resolutionEvaluatedAt        DateTime?
  contextCapturedByAccountId   String?        @db.Uuid
  /// RAB-TRUTH-01H — the AHSP's ownership AT THE MOMENT this calculation
  /// context was frozen. `AHSP.ownershipType` is mutable: a lawful transfer can
  /// change it later, and reading it live made a finished calculation's origin
  /// drift from "Data Pengguna" to "Auto SIMPROK" with nothing recalculated.
  /// Captured once here, beside the other facts this row already freezes, and
  /// never updated afterwards.
  ///
  /// NULL means the historical value is genuinely unknown — it is never filled
  /// in from today's ownership.
  ///
  /// `BasicPrice.assetScope` is deliberately NOT copied alongside it: no
  /// production writer ever updates that column, so `selectedBasicPriceId`
  /// already points at stable evidence and duplicating it would create a
  /// second truth to keep in step.
  ///
  /// Typed with the domain's own `OwnershipType` rather than free text: the
  /// database then refuses a value that is not a real ownership, and the
  /// column compares directly against `ahsps.ownershipType` instead of needing
  /// a cast to be read.
  ahspOwnershipAtCalculation   OwnershipType?
  createdAt                    DateTime       @default(now())
  updatedAt                    DateTime       @updatedAt

  workspace                Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                  Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ahspVersion              AHSPVersion                     @relation(fields: [ahspVersionId], references: [id], onDelete: Restrict)
  resourceResolutions      ProjectAhspResourceResolution[]
  referenceRegion          Region?                         @relation(fields: [referenceRegionId], references: [id], onDelete: Restrict)
  contextCapturedByAccount Account?                        @relation("ProjectAhspOccurrenceContextCapturedBy", fields: [contextCapturedByAccountId], references: [id], onDelete: Restrict)
  previousOccurrence       ProjectAhspOccurrence?          @relation("ProjectAhspOccurrenceLineage", fields: [previousOccurrenceId], references: [id], onDelete: Restrict)
  nextOccurrences          ProjectAhspOccurrence[]         @relation("ProjectAhspOccurrenceLineage")
  // GATE-2A: BoqItem rows whose server-computed line cites this occurrence
  // as its price provenance (BoqItem.calculationOccurrenceId).
  calculatedBoqItems       BoqItem[]                       @relation("BoqItemCalculationOccurrence")
  workingBoqItems          BoqItem[]                       @relation("BoqItemWorkingOccurrence")

  @@unique([projectId, idempotencyKey])
  @@index([workspaceId])
  @@index([projectId])
  @@index([ahspVersionId])
  @@index([referenceRegionId])
  @@index([previousOccurrenceId])
  @@index([workspaceId, projectId, ahspVersionId, businessPricingAsOfDate, referenceRegionId, resolutionPolicyVersion, generation])
  @@map("project_ahsp_occurrences")
}

model ProjectAhspResourceResolution {
  id                        String                      @id @default(uuid()) @db.Uuid
  occurrenceId              String                      @db.Uuid
  ahspResourceId            String                      @db.Uuid
  rawAhspResourceRef        String
  rawAhspResourceType       String
  ahspCoefficient           Decimal                     @db.Decimal(18, 6)
  ahspUnit                  String
  resourceCatalogId         String?                     @db.Uuid
  selectedBasicPriceId      String?                     @db.Uuid
  status                    ProjectAhspResolutionStatus
  selectionMode             ProjectAhspSelectionMode?
  canonicalUnit             String?
  sourcePriceValue          Decimal?                    @db.Decimal(18, 2)
  sourceUnit                String?
  adaptedPriceValue         Decimal?                    @db.Decimal(18, 2)
  conversionFactor          Decimal?                    @db.Decimal(18, 6)
  sourceUnitDefinitionId    String?                     @db.Uuid
  targetUnitDefinitionId    String?                     @db.Uuid
  unitConversionRuleId      String?                     @db.Uuid
  unitConversionRuleVersion Int?
  quantityFactor            Decimal?                    @db.Decimal(24, 12)
  selectedSourceOrigin      PriceSourceOrigin?
  selectedFreshnessStatus   PriceFreshnessStatus?
  selectedEffectiveDate     DateTime?
  resolutionMethod          ProjectAhspResolutionMethod
  reasonCodes               String[]
  explanation               String                      @db.Text
  policyVersion             String
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  occurrence           ProjectAhspOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  originalResource     AHSPResource          @relation(fields: [ahspResourceId], references: [id], onDelete: Restrict)
  resolvedCatalog      ResourceCatalog?      @relation(fields: [resourceCatalogId], references: [id], onDelete: Restrict)
  selectedBasicPrice   BasicPrice?           @relation(fields: [selectedBasicPriceId], references: [id], onDelete: Restrict)
  sourceUnitDefinition UnitDefinition?       @relation("ResolutionSourceUnit", fields: [sourceUnitDefinitionId], references: [id], onDelete: Restrict, map: "pahr_sourceUnitDefinitionId_fkey")
  targetUnitDefinition UnitDefinition?       @relation("ResolutionTargetUnit", fields: [targetUnitDefinitionId], references: [id], onDelete: Restrict, map: "pahr_targetUnitDefinitionId_fkey")
  unitConversionRule   UnitConversionRule?   @relation(fields: [unitConversionRuleId], references: [id], onDelete: Restrict, map: "pahr_unitConversionRuleId_fkey")

  @@unique([occurrenceId, ahspResourceId], map: "pahr_occurrence_ahsp_resource_key")
  @@index([occurrenceId])
  @@index([ahspResourceId])
  @@index([resourceCatalogId])
  @@index([selectedBasicPriceId])
  @@index([sourceUnitDefinitionId])
  @@index([targetUnitDefinitionId])
  @@index([unitConversionRuleId])
  @@index([status])
  @@map("project_ahsp_resource_resolutions")
}

// =====================================================
// SECTION H: BOQ & RAB DOMAIN
// =====================================================

model BoqStructure {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String?  @db.Uuid
  name      String
  version   Int
  status    String   @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   BoqItem[]
  rabs    RabDocument[]

  @@index([projectId])
  @@map("boq_structures")
}

enum BoqItemType {
  FOLDER
  WORK_ITEM
  NOTE
}

/// GATE-2A: who is authoritative for BoqItem.unitPrice/lineTotal on this row.
/// NULL = unpriced (no money, no provenance — the only legal state for a
/// fresh row). MANUAL_CLIENT = human-typed price via saveDraftBoq, with
/// every kernel provenance field NULL. SERVER_COST_KERNEL = written only by
/// RabKernelPersistenceService's atomic persist command, with every
/// provenance field required NOT NULL. The exact three shapes are enforced
/// at the database boundary by boq_item_price_origin_truth_check — see the
/// Gate-2A migration. saveDraftBoq must never move a row from
/// SERVER_COST_KERNEL back to MANUAL_CLIENT or NULL.
enum BoqItemPriceOrigin {
  MANUAL_CLIENT
  SERVER_COST_KERNEL
}

model BoqItem {
  id                  String      @id @default(uuid()) @db.Uuid
  boqStructureId      String      @db.Uuid
  parentId            String?     @db.Uuid
  wbsNodeId           String?     @db.Uuid
  wbsCode             String
  name                String
  itemType            BoqItemType @default(WORK_ITEM)
  quantity            Decimal     @db.Decimal(18, 6)
  unit                String
  unitPrice           Decimal?    @db.Decimal(18, 2)
  lineTotal           Decimal?    @db.Decimal(18, 2)
  sortOrder           Int         @default(0)
  ahspVersionId       String?     @db.Uuid
  ahspSnapshotId      String?     @db.Uuid
  workingOccurrenceId String?     @db.Uuid

  // GATE-2A provenance — minimum snapshot fields for a server-computed line.
  // All four are meaningful only when priceOrigin = SERVER_COST_KERNEL; they
  // stay at their defaults/null for every manual or not-yet-calculated row.
  priceOrigin              BoqItemPriceOrigin?
  calculationOccurrenceId  String?             @db.Uuid
  calculationAsOfDate      DateTime?           @db.Date
  calculatedAt             DateTime?
  calculationPolicyVersion String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boqStructure          BoqStructure           @relation(fields: [boqStructureId], references: [id], onDelete: Cascade)
  parent                BoqItem?               @relation("BoqItemToParent", fields: [parentId], references: [id])
  children              BoqItem[]              @relation("BoqItemToParent")
  wbsNode               WbsNode?               @relation(fields: [wbsNodeId], references: [id])
  ahspVersion           AHSPVersion?           @relation(fields: [ahspVersionId], references: [id])
  ahspSnapshot          AHSPSnapshot?          @relation(fields: [ahspSnapshotId], references: [id])
  calculationOccurrence ProjectAhspOccurrence? @relation("BoqItemCalculationOccurrence", fields: [calculationOccurrenceId], references: [id], onDelete: Restrict)
  workingOccurrence     ProjectAhspOccurrence? @relation("BoqItemWorkingOccurrence", fields: [workingOccurrenceId], references: [id], onDelete: Restrict)
  progressEntries       ProgressEntry[]

  @@index([boqStructureId])
  @@index([parentId])
  @@index([wbsNodeId])
  @@index([calculationOccurrenceId])
  @@index([workingOccurrenceId])
  @@map("boq_items")
}

model RabDocument {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String?  @db.Uuid
  boqStructureId  String   @db.Uuid
  version         Int
  name            String
  documentType    String?
  businessLabel   String?
  overheadPercent Decimal  @default(0) @db.Decimal(5, 2)
  profitPercent   Decimal  @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal  @default(0) @db.Decimal(5, 2)
  totalBaseCost   Decimal? @db.Decimal(18, 2)
  totalFinalCost  Decimal? @db.Decimal(18, 2)
  /// RAB lifecycle: DRAFT -> LOCKED -> APPROVED. RAB_STATUS in
  /// rab-lifecycle-policy.service.ts is the one authority over these values.
  /// LOCKED is the SAME document frozen — never a copy, never an approval.
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// RM-03D1 LOCK v1 — who froze this RAB, when, and from which state.
  ///
  /// These sit on the document rather than in an audit table because no
  /// existing durable mechanism can carry the fact: AHSPAuditLog,
  /// BasicPricePublicationAudit and BasicPriceProvenanceCorrection are each
  /// bound by a NOT NULL foreign key into their own domain, and KnowledgeEvent
  /// is the immutable reality-intake ledger. Three nullable columns on the row
  /// being frozen is the smallest thing that answers who/when/from-what
  /// without inventing a governance table.
  ///
  /// `lockedFromStatus` records the prior state explicitly rather than being
  /// assumed to be DRAFT, so the transition stays provable if the lifecycle
  /// ever gains another predecessor.
  lockedAt          DateTime?
  lockedByAccountId String?   @db.Uuid
  lockedFromStatus  String?

  project      Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqStructure BoqStructure      @relation(fields: [boqStructureId], references: [id])
  baselines    ProjectBaseline[]
  /// Restrict, not cascade: deleting an account must never silently erase who
  /// froze a RAB — the same rule the price-correction actor already follows.
  lockedBy     Account?          @relation("RabDocumentLockedBy", fields: [lockedByAccountId], references: [id], onDelete: Restrict, map: "fk_rab_document_locked_by")

  @@index([projectId])
  @@index([lockedByAccountId])
  @@map("rab_documents")
}

// =====================================================
// SECTION I: BASELINE GOVERNANCE DOMAIN
// =====================================================

model ProjectBaseline {
  id                   String   @id @default(uuid()) @db.Uuid
  projectId            String   @db.Uuid
  rabDocumentId        String   @db.Uuid
  versionNumber        Int
  status               String   @default("ACTIVE")
  approvedAt           DateTime
  approvedByPositionId String?  @db.Uuid
  justification        String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rabDocument     RabDocument      @relation(fields: [rabDocumentId], references: [id])
  approvedBy      Position?        @relation(fields: [approvedByPositionId], references: [id])
  progressReports ProgressReport[]

  @@index([projectId])
  @@map("project_baselines")
}

// =====================================================
// SECTION J: MONITORING & DEVIATION DOMAIN
// =====================================================

model ProgressReport {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @db.Uuid
  baselineId         String   @db.Uuid
  periodStartDate    DateTime
  periodEndDate      DateTime
  status             String   @default("DRAFT")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  commandId          String?  @unique
  commandFingerprint String?

  overallPlannedProgress Decimal? @db.Decimal(5, 2)
  overallActualProgress  Decimal? @db.Decimal(5, 2)
  overallPlannedCost     Decimal? @db.Decimal(18, 2)
  overallActualCost      Decimal? @db.Decimal(18, 2)

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseline         ProjectBaseline   @relation(fields: [baselineId], references: [id])
  entries          ProgressEntry[]
  deviationSignals DeviationSignal[]
  forecasts        ProjectForecast[]

  @@index([projectId])
  @@map("progress_reports")
}

enum ProgressActualStatus {
  LEGACY_UNSPECIFIED
  RECORDED
  SUBMITTED
  VERIFIED
  ACCEPTED
  RETURNED_FOR_CORRECTION
}

enum ProgressAuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum ProgressCorrectionReasonCode {
  DATA_ENTRY_ERROR
  MEASUREMENT_UPDATE
  FIELD_FACT_CORRECTION
  ADMINISTRATIVE_CORRECTION
  OTHER
}

model ProgressEntry {
  id                String   @id @default(uuid()) @db.Uuid
  progressReportId  String   @db.Uuid
  boqItemId         String   @db.Uuid
  installedQuantity Decimal  @db.Decimal(18, 2)
  actualCost        Decimal? @db.Decimal(18, 2)
  earnedValue       Decimal? @db.Decimal(18, 2)

  status                 ProgressActualStatus          @default(SUBMITTED)
  captureMethod          String                        @default("LEGACY_UNSPECIFIED")
  evidenceReferences     Json?
  recordedByAccountId    String?                       @db.Uuid
  recordedByMembershipId String?                       @db.Uuid
  supersedesEntryId      String?                       @unique @db.Uuid
  correctionReasonCode   ProgressCorrectionReasonCode?
  correctionReason       String?                       @db.Text
  revision               Int                           @default(1)

  workDate DateTime?
  notes    String?   @db.Text
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progressReport     ProgressReport       @relation(fields: [progressReportId], references: [id], onDelete: Cascade)
  boqItem            BoqItem              @relation(fields: [boqItemId], references: [id])
  recordedBy         Account?             @relation("ProgressEntryRecorder", fields: [recordedByAccountId], references: [id], onDelete: Restrict)
  recorderMembership WorkspaceMembership? @relation("ProgressEntryMembership", fields: [recordedByMembershipId], references: [id], onDelete: Restrict)
  supersedes         ProgressEntry?       @relation("ProgressEntryCorrection", fields: [supersedesEntryId], references: [id], onDelete: Restrict)
  correction         ProgressEntry?       @relation("ProgressEntryCorrection")
  auditEvents        ProgressAuditEvent[]

  @@index([progressReportId])
  @@index([boqItemId, createdAt])
  @@index([recordedByAccountId])
  @@index([recordedByMembershipId])
  @@map("progress_entries")
}

model ProgressAuditEvent {
  id                    String               @id @default(uuid()) @db.Uuid
  schemaVersion         Int?
  eventType             String?
  outcome               ProgressAuditOutcome @default(SUCCESS)
  workspaceId           String               @db.Uuid
  projectId             String               @db.Uuid
  progressEntryId       String?              @db.Uuid
  actorAccountId        String               @db.Uuid
  actorMembershipId     String               @db.Uuid
  actorPositionId       String?              @db.Uuid
  actorType             String?
  action                String
  authorityCode         String?
  positionCodeSnapshot  String?
  roleInProjectSnapshot String?
  sourceModule          String?
  targetEntityType      String?
  targetEntityId        String?              @db.Uuid
  correlationId         String?              @db.Uuid
  requestId             String?              @db.Uuid
  businessCommandId     String?
  commandId             String?              @unique
  commandFingerprint    String?
  reason                String?              @db.Text
  reasonCode            String?
  reasonText            String?              @db.Text
  errorCode             String?
  entityVersionBefore   Int?
  entityVersionAfter    Int?
  evidenceReferences    Json?
  metadata              Json?
  occurredAt            DateTime             @default(now())
  recordedAt            DateTime?

  workspace       Workspace           @relation("ProgressAuditWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  progressEntry   ProgressEntry?      @relation(fields: [progressEntryId], references: [id], onDelete: Restrict)
  actor           Account             @relation("ProgressAuditActor", fields: [actorAccountId], references: [id], onDelete: Restrict)
  actorMembership WorkspaceMembership @relation("ProgressAuditMembership", fields: [actorMembershipId], references: [id], onDelete: Restrict)
  actorPosition   Position?           @relation("ProgressAuditPosition", fields: [actorPositionId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([progressEntryId, occurredAt])
  @@index([actorAccountId, occurredAt])
  @@index([outcome, occurredAt])
  @@index([businessCommandId])
  @@map("progress_audit_events")
}

enum DeviationType {
  PRICE
  QUANTITY
  PRODUCTIVITY
  SCHEDULE
}

enum SeverityLevel {
  NORMAL
  WATCH
  WARNING
  CRITICAL
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TrendDirection {
  IMPROVING
  STABLE
  DEGRADING
  VOLATILE
}

model DeviationSignal {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @db.Uuid
  progressReportId String         @db.Uuid
  type             DeviationType
  severity         SeverityLevel  @default(NORMAL)
  cpi              Decimal?       @db.Decimal(10, 4)
  spi              Decimal?       @db.Decimal(10, 4)
  trend            TrendDirection @default(STABLE)
  description      String         @db.Text
  createdAt        DateTime       @default(now())

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progressReport ProgressReport @relation(fields: [progressReportId], references: [id])
  risks          ProjectRisk[]

  @@index([projectId])
  @@map("deviation_signals")
}

// =====================================================
// SECTION K: RISK & FORECAST DOMAIN
// =====================================================

enum RiskCategory {
  COST
  SCHEDULE
  SCOPE
  QUALITY
}

enum RiskStatus {
  IDENTIFIED
  MITIGATING
  RESOLVED
  MATERIALIZED
}

model ProjectRisk {
  id                    String        @id @default(uuid()) @db.Uuid
  projectId             String        @db.Uuid
  deviationSignalId     String?       @db.Uuid
  title                 String        @default("Identified Risk")
  description           String?       @db.Text
  category              RiskCategory
  probability           Decimal       @db.Decimal(4, 3)
  impact                Decimal       @db.Decimal(18, 2)
  riskScore             Decimal       @db.Decimal(18, 2)
  classification        PriorityLevel @default(LOW)
  status                RiskStatus    @default(IDENTIFIED)
  escalatedToPositionId String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deviationSignal DeviationSignal? @relation(fields: [deviationSignalId], references: [id])
  escalatedTo     Position?        @relation(fields: [escalatedToPositionId], references: [id])

  @@index([projectId])
  @@map("project_risks")
}

enum ConfidenceLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

model ProjectForecast {
  id               String          @id @default(uuid()) @db.Uuid
  projectId        String          @db.Uuid
  progressReportId String          @db.Uuid
  eacCost          Decimal         @db.Decimal(18, 2)
  etcCost          Decimal         @db.Decimal(18, 2)
  projectedEndDate DateTime
  confidenceLevel  ConfidenceLevel @default(MEDIUM)
  createdAt        DateTime        @default(now())

  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  progressReport ProgressReport @relation(fields: [progressReportId], references: [id])

  @@index([projectId])
  @@map("project_forecasts")
}

// =====================================================
// SECTION L: RECOMMENDATION & DECISION SUPPORT DOMAIN
// =====================================================

enum RecommendationTrigger {
  RISK
  FORECAST
  DEVIATION
  PATTERN
}

enum RecommendationCategory {
  COST_RECOVERY
  SCHEDULE_RECOVERY
  RISK_MITIGATION
  OPPORTUNITY
  STRATEGIC_SIGNAL
}

enum RecommendationStatus {
  GENERATED
  VIEWED
  ACTED_ON
  DISMISSED
}

model Recommendation {
  id          String                 @id @default(uuid()) @db.Uuid
  projectId   String                 @db.Uuid
  triggerType RecommendationTrigger
  triggerId   String                 @db.Uuid
  category    RecommendationCategory
  context     String                 @db.Text
  analysis    String                 @db.Text
  urgency     PriorityLevel          @default(LOW)
  status      RecommendationStatus   @default(GENERATED)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  options   RecommendationOption[]
  decisions FormalDecision[]

  @@index([projectId])
  @@map("recommendations")
}

model RecommendationOption {
  id               String   @id @default(uuid()) @db.Uuid
  recommendationId String   @db.Uuid
  description      String   @db.Text
  expectedImpact   String   @db.Text
  rank             Int
  createdAt        DateTime @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("recommendation_options")
}

enum DecisionStatus {
  RECORDED
  EXECUTING
  COMPLETED
}

model FormalDecision {
  id                  String         @id @default(uuid()) @db.Uuid
  projectId           String         @db.Uuid
  recommendationId    String?        @db.Uuid
  decidedByUserId     String         @db.Uuid
  decidedByPositionId String?        @db.Uuid
  decision            String         @db.Text
  rationale           String         @db.Text
  status              DecisionStatus @default(RECORDED)
  actualOutcome       String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recommendation    Recommendation? @relation(fields: [recommendationId], references: [id])
  decidedByUser     User            @relation(fields: [decidedByUserId], references: [id])
  decidedByPosition Position?       @relation(fields: [decidedByPositionId], references: [id])

  @@index([projectId])
  @@map("formal_decisions")
}
