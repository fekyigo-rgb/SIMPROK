// =====================================================
// SECTION D.2: PLATFORM GOVERNANCE (ABOVE WORKSPACE)
// =====================================================

/// The verb of ONE platform governance ceremony. Not a status, and not a second
/// authority vocabulary: the power itself is always an existing `Authority`.
///
/// `IngestionConnectorStatus { ACTIVE, REVOKED }` was inspected and deliberately
/// NOT reused — it names the lifecycle of an ingestion credential, and giving a
/// governance decision an "ingestion connector status" would change its meaning.
enum PlatformGovernanceDecisionType {
  GRANT
  REVOKE
}

/// PLATFORM GOVERNANCE — WHO MAY ACT ON SIMPROK'S OWN KNOWLEDGE.
///
/// OWNER-LOCKED PRODUCT LAW. SIMPROK has a governance layer ABOVE Workspace for
/// knowledge SIMPROK itself owns (the Official/Shared Repository — the models
/// whose `workspaceId` is nullable). That layer is strictly separate from
/// Owner/DIRECTOR, from Workspace RBAC, and from Project Authority.
///
/// THE SUBJECT IS AN ACCOUNT, DELIBERATELY. `Account` is the only workspace-
/// independent principal in SIMPROK (`memberships` is a list relation, so an
/// Account can exist with no workspace at all). Every other candidate is tenant-
/// bound: `Position.workspaceId` and `Role.workspaceId` are NOT NULL, and
/// `PositionAssignment` reaches a holder only through `User`, which cannot exist
/// without a `WorkspaceMembership`. Nothing here touches that chain — Position,
/// PositionAssignment and PositionAuthority keep their exact existing meaning and
/// remain the WORKSPACE authority machinery.
///
/// THE OBJECT IS AN EXISTING `Authority`. Its `code` is already globally unique
/// with no workspace, so the vocabulary is already platform-scoped. No second
/// authority vocabulary is introduced.
///
/// STATE AND HISTORY ARE ONE STRUCTURE. This follows the pattern
/// `AhspResourceIdentityDecision` and `ProjectAhspOccurrence` already prove:
/// history is APPENDED, never rewritten; the highest generation for a subject is
/// the current truth; superseded generations never silently revive. A GRANT at
/// the highest generation means the authority is held; a REVOKE at the highest
/// generation means it is not. Re-granting after a revoke is simply the next
/// generation, so `grant -> revoke -> grant` is fully representable without
/// mutating anything.
///
/// GRANTING IS NOT ITSELF AN AUTHORITY. Holding a platform authority confers no
/// power to grant or revoke one. Every row here is written under an explicit
/// Owner-authorized ceremony, and `ownerAuthorizationReference` is the
/// accountability record of that ceremony — see its own note below.
model PlatformGovernanceDecision {
  id String @id @default(uuid()) @db.Uuid

  /// THE HOLDER — the person who receives or loses the authority.
  holderAccountId String @db.Uuid
  /// THE POWER — an existing canonical Authority. Never a new vocabulary.
  authorityId     String @db.Uuid

  decision PlatformGovernanceDecisionType

  /// Lineage, mirroring AhspResourceIdentityDecision. Highest generation = current.
  generation         Int     @default(1)
  previousDecisionId String? @db.Uuid

  /// THE EXECUTING ACTOR — who performed the ceremony. Deliberately a SEPARATE
  /// column from `holderAccountId`: the person who executes a grant is not
  /// thereby its subject, and overloading one field would destroy that fact.
  executedByAccountId String @db.Uuid

  /// THE OWNER AUTHORIZATION REFERENCE — an OPAQUE, Owner-issued accountability
  /// reference, persisted as provenance.
  ///
  /// NOT MACHINE-VERIFIED, and SIMPROK must never claim otherwise. This column
  /// supports the statement "this governance action was executed under Owner
  /// authorization reference X". It does NOT support "SIMPROK verified that X was
  /// issued by the Owner". There is no signature, no key registry and no
  /// authorization service behind it, by Owner decision. What IS enforced is that
  /// it must be present and non-blank: an unattributable governance act is
  /// refused rather than recorded.
  ownerAuthorizationReference String

  /// Why this ceremony happened. Provenance for a human reading history later.
  reason String? @db.Text

  /// REPLAY PROTECTION, following ProjectAhspOccurrence's convention. The same
  /// command submitted twice resolves to the SAME generation instead of creating
  /// a second authoritative truth.
  idempotencyKey     String @unique
  /// A digest of the command's meaning. A second request bearing an existing
  /// idempotency key but a DIFFERENT fingerprint is a different command wearing
  /// a used name, and is refused rather than treated as a replay.
  commandFingerprint String

  decidedAt DateTime @default(now())

  holderAccount     Account                      @relation("PlatformGovernanceHolder", fields: [holderAccountId], references: [id], onDelete: Restrict)
  authority         Authority                    @relation(fields: [authorityId], references: [id], onDelete: Restrict)
  executedByAccount Account                      @relation("PlatformGovernanceExecutor", fields: [executedByAccountId], references: [id], onDelete: Restrict)
  previousDecision  PlatformGovernanceDecision?  @relation("PlatformGovernanceLineage", fields: [previousDecisionId], references: [id], onDelete: Restrict)
  nextDecisions     PlatformGovernanceDecision[] @relation("PlatformGovernanceLineage")

  /// THE CONCURRENCY INVARIANT. Two writers racing for the same next generation
  /// cannot both win; the loser re-reads and either resolves idempotently or
  /// returns a conflict. Duplicate authoritative truth is unrepresentable.
  @@unique([holderAccountId, authorityId, generation])
  /// The only read shape the resolver uses: newest decision for one exact
  /// subject. Bounded and indexed — never a scan, never "load all history".
  @@index([holderAccountId, authorityId, generation(sort: Desc)])
  @@index([authorityId])
  @@map("platform_governance_decisions")
}

// =====================================================
// SECTION G: RESOURCE CATALOG & BASIC PRICE DOMAIN
// =====================================================

enum ResourceType {
  MATERIAL
  LABOR
  EQUIPMENT
}

model ResourceCatalog {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String?      @db.Uuid
  code           String?
  name           String
  type           ResourceType
  baseUnit       String
  specifications Json?
  /// BP-KDN-01 — LEGACY COMPATIBILITY ONLY.
  ///
  /// A single nullable scalar cannot retain multiple lawful %KDN observations
  /// of one ResourceCatalog (manufacturer / source / spec / import row). The
  /// canonical observation fact lives on `BasicPrice.kdnPercent`, with
  /// provenance on `BasicPriceImportRow`. This column is not written by the
  /// KDN pipeline and is not the Detail reader.
  tkdnValue      Decimal?     @db.Decimal(5, 2)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  basicPrices                    BasicPrice[]
  workspace                      Workspace?                           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  priceSubmissions               PriceSubmission[]
  canonicalPricePoints           CanonicalPricePoint[]
  projectAhspResourceResolutions ProjectAhspResourceResolution[]
  unitConversionRules            UnitConversionRule[]
  basicPriceImportRows           BasicPriceImportRow[]
  sourceIdentities               ResourceSourceIdentity[]
  importRowResourceMappings      BasicPriceImportRowResourceMapping[]

  ahspResourceIdentityDecisions AhspResourceIdentityDecision[]

  // NOTE: the former @@unique([workspaceId, code]) is replaced by a manual
  // partial unique index in the migration SQL (RM-02C1a) because `code` is
  // now nullable and Prisma cannot express a partial/filtered unique index
  // in the schema DSL. See migration 20260727..._rm02c1a_resource_identity_schema_foundation.
  @@index([workspaceId])
  @@map("resource_catalogs")
}

/// RM-02C1a: provenance-only evidence of where a resource row was seen in a
/// source workbook. This is NEVER a canonical identity by itself — it never
/// automatically becomes ResourceCatalog.code, and multiple provenance rows
/// may point at the same ResourceCatalog (one resource, many source sightings).
model ResourceSourceIdentity {
  id                String @id @default(uuid()) @db.Uuid
  resourceCatalogId String @db.Uuid
  workspaceId       String @db.Uuid

  sourceSha256          String       @db.VarChar(64)
  sourceFileName        String
  parserContractVersion String
  sheetName             String
  sourceRowNumber       Int
  sourceSection         ResourceType

  sourceCodeCellAddress String?
  sourceNameCellAddress String
  sourceUnitCellAddress String?

  rawCode String?
  rawName String
  rawUnit String?

  createdAt DateTime @default(now())

  resourceCatalog ResourceCatalog @relation(fields: [resourceCatalogId], references: [id], onDelete: Restrict)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // No separate @@index([workspaceId]) — it would be a redundant prefix of
  // the composite unique index below, which Postgres can already use for
  // workspaceId-only lookups.
  @@unique([workspaceId, sourceSha256, sheetName, sourceRowNumber, parserContractVersion])
  @@index([resourceCatalogId])
  @@index([sourceSha256])
  @@map("resource_source_identities")
}

/// RM-03D1 — HOW an exact effectiveDate came to exist, which is a different
/// fact from the date itself.
///
/// A source that states only a PERIOD states no date. The Ambon Basic Price
/// evidence gives `Period = 2024` / `TA 2024` and nowhere prints a day, yet
/// BasicPrice.effectiveDate is NOT NULL because every downstream applicability
/// rule needs one. SIMPROK must therefore DERIVE an operational date — and a
/// derived date must never be readable as something the source printed.
///
/// NULL means the row predates this distinction: provenance unknown, which is
/// honest and is deliberately NOT the same as SOURCE_STATED. The absence of a
/// claim fails closed.
enum PriceEffectiveDateProvenance {
  /// The source document itself states this exact calendar date.
  SOURCE_STATED
  /// SIMPROK derived this date from a coarser source period, by a named rule.
  DERIVED_FROM_SOURCE_PERIOD
}

/// RM-03D1 — how coarse the source's stated period actually is, machine-readable.
///
/// `sourcePeriodLabel` is verbatim source text ("TA 2024") and therefore not
/// something code may reason over: a reader cannot tell from the string alone
/// whether the period is a year, a quarter or a fortnight. This column answers
/// that, so a derived date is re-derivable by machine and not only by a human
/// reading prose.
///
/// Only YEAR exists today because YEAR is the only granularity the evidence in
/// hand actually demonstrates. Inventing MONTH/QUARTER/SEMESTER now would be
/// vocabulary with no proven referent — the same false-certainty habit this
/// slice exists to close. A later migration adds a value when a source demands
/// one.
enum PriceSourcePeriodGranularity {
  YEAR
}

enum PriceSourceType {
  VENDOR_QUOTE
  MARKET_SURVEY
  REGULATION
  SYSTEM_ESTIMATE
}

enum PriceVerificationStatus {
  UNVERIFIED
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  PUBLISHED
}

enum PriceSourceOrigin {
  GOVERNMENT
  SUPPLIER
  STORE
  DISTRIBUTOR
  FIELD_REPORT
  COMMUNITY_REPORT
}

enum PriceFreshnessStatus {
  CURRENT
  EXPIRING
  EXPIRED
}

/// RM-03C — OWNERSHIP / ASSET SCOPE of a Basic Price. This is the answer to
/// "WHO OWNS THIS PRICE AND WHERE MAY IT BE USED", and it is the ONLY axis
/// that answers it.
///
/// It is deliberately NOT any of the following, all of which already exist as
/// their own independent columns and must never be collapsed into this one:
///   - publication status        -> BasicPrice.status
///   - verification status       -> BasicPrice.verificationStatus
///   - where the number came from -> BasicPrice.sourceOrigin / sourceType
///   - temporal validity          -> effectiveDate / validUntil / freshnessStatus
///
/// WORKSPACE_PRIVATE  a workspace's OWN price, made or imported because the
///                    catalog has nothing suitable. Usable by its owning
///                    workspace immediately once technically valid. It needs no
///                    national publication, no verifier, no publisher, and no
///                    second human. It is NEVER called PUBLISHED, and it never
///                    enters the SIMPROK catalog review/publication queue.
/// SIMPROK_CATALOG    a curated national/general price. Reaching public
///                    eligibility still requires the unchanged internal ladder
///                    (submission -> review -> ACCEPT -> publication), i.e.
///                    status = 'PUBLISHED' AND verificationStatus = PUBLISHED.
///
/// PRIVATE_USABLE != PUBLISHED. Orthogonality is load-bearing: a
/// WORKSPACE_PRIVATE price may truthfully carry sourceOrigin = GOVERNMENT,
/// SUPPLIER, STORE, DISTRIBUTOR or FIELD_REPORT — SOURCE != REPORTER and
/// OWNERSHIP != SOURCE. There is deliberately no "PRIVATE" source family.
enum BasicPriceAssetScope {
  WORKSPACE_PRIVATE
  SIMPROK_CATALOG
}

/// BP-KDN-01 / BP-CHANGE-SEM-03 — HOW a persisted %KDN fact was established.
///
/// SOURCE_IMPORT_ROW       the same import observation that produced the price
///                         also stated this %KDN. Price-source and KDN-source
///                         share that row, and that sharing is honest.
/// MANUAL_ENRICHMENT       an authorized actor filled a previously unknown %KDN
///                         later, without minting a fake new Basic Price. The
///                         price's import row is NOT this KDN's source.
/// MANUAL_CORRECTION       a previously stated %KDN was wrong and was restated
///                         by a superseding observation. Not enrichment.
/// MANUAL_NEW_OBSERVATION  a later lawful %KDN fact in a new context/date.
///                         Not a claim that the older %KDN was an error.
///
/// CHECK `basic_prices_kdn_pair_check` forbids stated %KDN with a null
/// establishment. Correction and new observation therefore cannot wear NULL;
/// they also must not wear ENRICHMENT or IMPORT, which would lie about how
/// the fact was established.
enum BasicPriceKdnEstablishment {
  SOURCE_IMPORT_ROW
  MANUAL_ENRICHMENT
  MANUAL_CORRECTION
  MANUAL_NEW_OBSERVATION
}

/// BP-KDN-01 — whether this batch auto-mapped a %KDN column.
/// ABSENT        the source stated no KDN heading. Import continues.
/// ESTABLISHED   exactly one CLEAR heading, or a human confirmed a candidate.
/// NEEDS_REVIEW  ambiguous and/or conflicting KDN-like headings. No guess.
enum BasicPriceKdnMappingStatus {
  ABSENT
  ESTABLISHED
  NEEDS_REVIEW
}

enum PriceSubmissionStatus {
  SUBMITTED
  NEEDS_CORRECTION
  RESUBMITTED
  ACCEPTED
  UNDER_REVIEW
  VERIFIED
  PUBLISHED
  REJECTED
}

enum PriceSubmissionActorType {
  SYSTEM
  HUMAN
}

model PriceSubmission {
  id                  String                @id @default(uuid()) @db.Uuid
  workspaceId         String?               @db.Uuid
  organizationId      String?               @db.Uuid
  resourceId          String                @db.Uuid
  regionId            String?               @db.Uuid
  reportedByAccountId String?               @db.Uuid // TODO FK to Account later
  sourceOrigin        PriceSourceOrigin
  sourceType          PriceSourceType       @default(MARKET_SURVEY)
  status              PriceSubmissionStatus @default(SUBMITTED)
  currentRevisionId   String?               @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  resource        ResourceCatalog           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  workspace       Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  region          Region?                   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  revisions       PriceSubmissionRevision[]
  audits          PriceSubmissionAudit[]
  publishedPrices BasicPrice[]
  review          PriceSubmissionReview?
  importRow       BasicPriceImportRow?

  @@index([workspaceId])
  @@index([workspaceId, organizationId])
  @@index([organizationId])
  @@index([resourceId])
  @@index([reportedByAccountId])
  @@index([status])
  @@index([regionId])
  @@map("price_submissions")
}

model PriceSubmissionRevision {
  id                String    @id @default(uuid()) @db.Uuid
  submissionId      String    @db.Uuid
  revisionNumber    Int
  value             Decimal   @db.Decimal(18, 2)
  effectiveDate     DateTime?
  validUntil        DateTime?
  photoUrl          String?
  gpsLat            Decimal?  @db.Decimal(10, 7)
  gpsLng            Decimal?  @db.Decimal(10, 7)
  note              String?   @db.Text
  validationPassed  Boolean   @default(false)
