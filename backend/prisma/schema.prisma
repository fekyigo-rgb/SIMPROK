// =======================================================
// SIMPROK - SCHEMA BASELINE 001
// Checkpoint: 31 | Date: 2026-06-16
// Status: READY FOR MIGRATION
// =======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// SECTION A: IDENTITY & BOUNDARY FOUNDATION
// =====================================================

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  displayName  String
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships                                 WorkspaceMembership[]
  intelligenceEvidence                        IntelligenceEvidence[]
  verifiedBasicPriceSourceEquivalences        BasicPriceSourceEquivalence[]        @relation("BasicPriceSourceEquivalenceVerifiedBy")
  reviewedBasicPriceImportRowResourceMappings BasicPriceImportRowResourceMapping[] @relation("BasicPriceImportRowResourceMappingReviewer")
  basicPricePublicationAudits                 BasicPricePublicationAudit[]         @relation("BasicPricePublicationAuditActor")
  basicPriceProvenanceCorrections             BasicPriceProvenanceCorrection[]     @relation("BasicPriceProvenanceCorrectionActor")
  lockedRabDocuments                          RabDocument[]                        @relation("RabDocumentLockedBy")
  capturedProjectAhspOccurrences              ProjectAhspOccurrence[]              @relation("ProjectAhspOccurrenceContextCapturedBy")
  recordedProgressEntries                     ProgressEntry[]                      @relation("ProgressEntryRecorder")
  progressAuditEvents                         ProgressAuditEvent[]                 @relation("ProgressAuditActor")
  projectTimeZoneEvents                       ProjectTimeZoneEvent[]

  @@map("accounts")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Organization {
  id        String           @id @default(uuid()) @db.Uuid
  name      String
  type      OrganizationType @default(COMPANY)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  workspaces             Workspace[]
  projects               Project[]
  priceSubmissionReviews PriceSubmissionReview[]
  intelligenceEvidence   IntelligenceEvidence[]

  @@map("organizations")
}

enum OrganizationType {
  PERSONAL
  COMPANY
  GOVERNMENT
  STATE_OWNED_ENTERPRISE
  CONSULTANT
  NON_PROFIT
  EDUCATION
}

model Workspace {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization                    Organization                     @relation(fields: [organizationId], references: [id])
  memberships                     WorkspaceMembership[]
  roles                           Role[]
  positions                       Position[]
  approvalMatrices                ApprovalMatrix[]
  projects                        Project[]
  stakeholderBridges              ProjectStakeholder[]
  ahsps                           AHSP[]
  ahspVersions                    AHSPVersion[]
  ahspSnapshots                   AHSPSnapshot[]
  resourceCatalogs                ResourceCatalog[]
  basicPrices                     BasicPrice[]
  priceSubmissions                PriceSubmission[]
  priceSubmissionReviews          PriceSubmissionReview[]
  intelligenceEvidence            IntelligenceEvidence[]
  projectAhspOccurrences          ProjectAhspOccurrence[]
  resourceSourceIdentities        ResourceSourceIdentity[]
  basicPriceSourceEquivalences    BasicPriceSourceEquivalence[]
  basicPriceProvenanceCorrections BasicPriceProvenanceCorrection[]
  progressAuditEvents             ProgressAuditEvent[]             @relation("ProgressAuditWorkspace")
  projectTimeZoneEvents           ProjectTimeZoneEvent[]

  @@index([organizationId])
  @@map("workspaces")
}

// =====================================================
// SECTION B: ACCESS GATEWAY & OPERATIONAL RESOURCE
// =====================================================

enum MembershipStatus {
  INVITED
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  EXPIRED
  REJECTED
}

model WorkspaceMembership {
  id          String           @id @default(uuid()) @db.Uuid
  accountId   String           @db.Uuid
  workspaceId String           @db.Uuid
  status      MembershipStatus @default(INVITED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  account                 Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace               Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userProfile             User?
  membershipRoles         MembershipRole[]
  assignments             ProjectAssignment[]
  recordedProgressEntries ProgressEntry[]        @relation("ProgressEntryMembership")
  progressAuditEvents     ProgressAuditEvent[]   @relation("ProgressAuditMembership")
  projectTimeZoneEvents   ProjectTimeZoneEvent[]

  @@unique([accountId, workspaceId])
  @@index([accountId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  workspaceMembershipId String     @unique @db.Uuid
  workspaceId           String     @db.Uuid
  fullName              String
  status                UserStatus @default(ACTIVE)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  membership          WorkspaceMembership  @relation(fields: [workspaceMembershipId], references: [id], onDelete: Cascade)
  positionAssignments PositionAssignment[]

  createdAHSPs                   AHSP[]                          @relation("AHSPCreatedBy")
  approvedAHSPs                  AHSP[]                          @relation("AHSPApprovedBy")
  transferredAHSPs               AHSP[]                          @relation("AHSPOwnershipTransferredBy")
  archivedAHSPs                  AHSP[]                          @relation("AHSPArchivedBy")
  deletedAHSPs                   AHSP[]                          @relation("AHSPDeletedBy")
  FormalDecision                 FormalDecision[]
  assignedPriceSubmissionReviews PriceSubmissionReview[]         @relation("PriceSubmissionReviewAssignedTo")
  priceSubmissionReviewDecisions PriceSubmissionReviewDecision[] @relation("PriceSubmissionReviewDecidedBy")

  @@map("users")
}

// =====================================================
// SECTION C: PARALEL RBAC ENGINE (WORKSPACE OWNED)
// =====================================================

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  code        String
  name        String
  description String?  @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  membershipRoles MembershipRole[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceMembershipId String    @db.Uuid
  roleId                String    @db.Uuid
  startDate             DateTime  @default(now())
  endDate               DateTime?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspaceMembership WorkspaceMembership @relation(fields: [workspaceMembershipId], references: [id], onDelete: Cascade)
  role                Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([workspaceMembershipId])
  @@index([roleId])
  @@index([isActive])
  @@map("membership_roles")
}

// =====================================================
// SECTION D: AUTHORITY & PROJECT BOUNDARY
// =====================================================

model Position {
  id               String   @id @default(uuid()) @db.Uuid
  workspaceId      String   @db.Uuid
  name             String
  code             String
  parentPositionId String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentPosition      Position?            @relation("PositionToParent", fields: [parentPositionId], references: [id])
  childPositions      Position[]           @relation("PositionToParent")
  assignments         PositionAssignment[]
  approvalMatrices    ApprovalMatrix[]
  positionAuthorities PositionAuthority[]
  projectBaselines    ProjectBaseline[]
  projectRisks        ProjectRisk[]
  formalDecisions     FormalDecision[]
  progressAuditEvents ProgressAuditEvent[] @relation("ProgressAuditPosition")

  @@index([workspaceId])
  @@map("positions")
}

model PositionAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  positionId String    @db.Uuid
  userId     String    @db.Uuid
  assignedAt DateTime  @default(now())
  removedAt  DateTime?
  isActive   Boolean   @default(true)

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([positionId])
  @@map("position_assignments")
}

model ApprovalMatrix {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  authorityId        String   @db.Uuid
  objectType         String
  requiredPositionId String   @db.Uuid
  minValue           Decimal? @db.Decimal(18, 2)
  maxValue           Decimal? @db.Decimal(18, 2)
  priority           Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authority        Authority @relation(fields: [authorityId], references: [id])
  requiredPosition Position  @relation(fields: [requiredPositionId], references: [id])

  @@index([workspaceId])
  @@index([authorityId])
  @@index([requiredPositionId])
  @@map("approval_matrices")
}

// =====================================================
// SECTION E: PROJECT ENGINE & MULTI-STAKEHOLDER ARENA
// =====================================================

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  organizationId   String        @db.Uuid
  code             String
  name             String
  description      String?       @db.Text
  mainMaterialSpec String?       @db.Text
  location         String?
  clientName       String?
  type             ProjectType   @default(GENERAL)
  address          Json?
  budgetBaseline   Decimal?      @db.Decimal(18, 2)
  startDate        DateTime?
  endDate          DateTime?
  timeZone         String?       @db.VarChar(64)
  createdById      String?       @db.Uuid
  deletedAt        DateTime?
  status           ProjectStatus @default(PLANNED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts            ProjectContract[]
  stakeholders         ProjectStakeholder[]
  assignments          ProjectAssignment[]
  wbsNodes             WbsNode[]
  boqStructures        BoqStructure[]
  rabDocuments         RabDocument[]
  baselines            ProjectBaseline[]
  progressReports      ProgressReport[]
  deviationSignals     DeviationSignal[]
  risks                ProjectRisk[]
  forecasts            ProjectForecast[]
  recommendations      Recommendation[]
  formalDecisions      FormalDecision[]
  intelligenceEvidence IntelligenceEvidence[]
  ahspOccurrences      ProjectAhspOccurrence[]
  progressAuditEvents  ProgressAuditEvent[]
  timeZoneEvents       ProjectTimeZoneEvent[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([organizationId])
  @@map("projects")
}

model ProjectTimeZoneEvent {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @db.Uuid
  projectId         String   @db.Uuid
  actorAccountId    String   @db.Uuid
  actorMembershipId String   @db.Uuid
  previousTimeZone  String?  @db.VarChar(64)
  nextTimeZone      String?  @db.VarChar(64)
  action            String
  reason            String?  @db.Text
  occurredAt        DateTime @default(now())

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project         Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor           Account             @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)
  actorMembership WorkspaceMembership @relation(fields: [actorMembershipId], references: [id], onDelete: Restrict)

  @@index([workspaceId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([actorAccountId, occurredAt])
  @@map("project_time_zone_events")
}

enum ProjectType {
  GENERAL
  EPCC
  CONSTRUCTION_ONLY
  DESIGN_ONLY
  RENOVATION
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum IntelligenceEvidenceStatus {
  READY
  PARTIAL
  NEEDS_REVIEW
  REJECTED_BY_POLICY
  PROVIDER_UNAVAILABLE
}

enum IntelligenceEfPermission {
  ALLOWED
  NOT_ALLOWED
  SELECTED_ITEMS_ONLY
}

model IntelligenceEvidence {
  id                    String                     @id @default(uuid()) @db.Uuid
  requestId             String
  workspaceId           String                     @db.Uuid
  organizationId        String                     @db.Uuid
  projectId             String                     @db.Uuid
  accountId             String                     @db.Uuid
  providerIdentifier    String?
  modelIdentifier       String?
  policyVersion         String
  inputHash             String
  status                IntelligenceEvidenceStatus
  sourceReferences      String[]
  toolsRequested        String[]
  toolsAllowed          String[]
  toolsDenied           String[]
  selectedAhspIds       String[]
  selectedBasicPriceIds String[]
  efPermission          IntelligenceEfPermission
  efReferences          String[]
  confidence            Float?
  reasonCodes           String[]
  policyRejections      String[]
  createdAt             DateTime                   @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([workspaceId, organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([accountId, createdAt])
  @@index([createdAt])
  @@map("intelligence_evidence")
}

model ProjectContract {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @db.Uuid
  contractNumber String
  value          Decimal  @db.Decimal(18, 2)
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, contractNumber])
  @@map("project_contracts")
}

model ProjectStakeholder {
  id          String          @id @default(uuid()) @db.Uuid
  projectId   String          @db.Uuid
  workspaceId String          @db.Uuid
  roleType    StakeholderType @default(CONTRACTOR)
  joinedAt    DateTime        @default(now())

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([projectId, workspaceId])
  @@index([projectId])
  @@index([workspaceId])
  @@map("project_stakeholders")
}

enum StakeholderType {
  OWNER
  CONTRACTOR
  SUPERVISORY_CONSULTANT
  PLANNING_CONSULTANT
}

enum AssignmentStatus {
  ASSIGNED
  INACTIVE
  REMOVED
}

model ProjectAssignment {
  id                    String           @id @default(uuid()) @db.Uuid
  workspaceMembershipId String           @db.Uuid
  projectId             String           @db.Uuid
  roleInProject         String
  assignedAt            DateTime         @default(now())
  revokedAt             DateTime?
  isPrimaryAssignment   Boolean          @default(false)
  status                AssignmentStatus @default(ASSIGNED)

  membership WorkspaceMembership @relation(fields: [workspaceMembershipId], references: [id], onDelete: Cascade)
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceMembershipId, projectId])
  @@index([workspaceMembershipId])
  @@index([projectId])
  @@map("project_assignments")
}

enum WbsNodeType {
  LOCATION
  ELEMENT
  WORK_ITEM
}

model WbsNode {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  parentId  String?     @db.Uuid
  nodeType  WbsNodeType
  code      String
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   WbsNode?  @relation("WbsToWbs", fields: [parentId], references: [id])
  children WbsNode[] @relation("WbsToWbs")
  boqItems BoqItem[]

  @@index([projectId])
  @@index([parentId])
  @@map("wbs_nodes")
}

// =====================================================
// SECTION F: AHSP DOMAIN (RESOURCE & METHOD FORMULA)
// =====================================================

enum MethodType {
  MANUAL
  MECHANICAL
  SEMI_MECHANICAL
  CHEMICAL
  OTHER
}

enum LocationType {
  GENERAL
  URBAN
  RURAL
  MOUNTAIN
  SWAMP
  COASTAL
  OFFSHORE
  OTHER
}

enum AhspVersionStatus {
  DRAFT
  UNDER_REVIEW
  VERIFIED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum SourceType {
  OFFICIAL
  WORKSPACE
  USER
  SYSTEM
}

enum UnitDimension {
  COUNT
  MASS
  LENGTH
  AREA
  VOLUME
  TIME
  PERSON_TIME
  EQUIPMENT_TIME
}

enum UnitKind {
  CANONICAL
  COMMERCIAL_PACKAGE
  CONTEXTUAL
}

enum UnitConversionType {
  EXACT_GLOBAL
  PACKAGE_CONTENT
  RESOURCE_SPECIFIC
  DENSITY_REQUIRED
  CONTEXTUAL_TIME
  NOT_CONVERTIBLE
}

enum UnitConversionRuleStatus {
  ACTIVE
  RETIRED
}

model UnitDefinition {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  displayName String
  symbol      String
  dimension   UnitDimension
  kind        UnitKind
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  aliases                   UnitAlias[]
  sourceConversionRules     UnitConversionRule[]                 @relation("UnitRuleSource")
  targetConversionRules     UnitConversionRule[]                 @relation("UnitRuleTarget")
  ahspVersions              AHSPVersion[]                        @relation("AHSPVersionOutputUnit")
  ahspSnapshots             AHSPSnapshot[]                       @relation("AHSPSnapshotOutputUnit")
  resolutionSourceUnits     ProjectAhspResourceResolution[]      @relation("ResolutionSourceUnit")
  resolutionTargetUnits     ProjectAhspResourceResolution[]      @relation("ResolutionTargetUnit")
  basicPriceImportRows      BasicPriceImportRow[]
  importRowResourceMappings BasicPriceImportRowResourceMapping[]

  @@map("unit_definitions")
}

model UnitAlias {
  id               String   @id @default(uuid()) @db.Uuid
  rawAlias         String
  normalizedAlias  String
  unitDefinitionId String   @db.Uuid
  context          String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unitDefinition UnitDefinition @relation(fields: [unitDefinitionId], references: [id], onDelete: Restrict)

  @@index([normalizedAlias, isActive])
  @@index([unitDefinitionId])
  @@map("unit_aliases")
}

model UnitConversionRule {
  id                String                   @id @default(uuid()) @db.Uuid
  sourceUnitId      String                   @db.Uuid
  targetUnitId      String                   @db.Uuid
  conversionType    UnitConversionType
  quantityFactor    Decimal                  @db.Decimal(24, 12)
  resourceCatalogId String?                  @db.Uuid
  evidenceReference String?
  evidenceHash      String?
  evidencePayload   Json?
  version           Int
  status            UnitConversionRuleStatus @default(ACTIVE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  sourceUnit      UnitDefinition                  @relation("UnitRuleSource", fields: [sourceUnitId], references: [id], onDelete: Restrict)
  targetUnit      UnitDefinition                  @relation("UnitRuleTarget", fields: [targetUnitId], references: [id], onDelete: Restrict)
  resourceCatalog ResourceCatalog?                @relation(fields: [resourceCatalogId], references: [id], onDelete: Restrict)
  resolutions     ProjectAhspResourceResolution[]

  @@unique([sourceUnitId, targetUnitId, conversionType, resourceCatalogId, version], map: "unit_conversion_rule_version_key")
  @@index([sourceUnitId, targetUnitId, status])
  @@index([resourceCatalogId])
  @@map("unit_conversion_rules")
}

enum ImportStatus {
  PENDING
  RUNNING
  FAILED
  PARTIAL_SUCCESS
  COMPLETED
}

model AHSP {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String?      @db.Uuid // NULL for Official Repository (Tenant Scope)
  workType     String
  methodType   MethodType
  locationType LocationType
  methodName   String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  ownershipType OwnershipType @default(USER_ASSET)
  reviewStatus  ReviewStatus  @default(PENDING)

  createdByUserId  String?   @db.Uuid
  approvedAt       DateTime?
  approvedByUserId String?   @db.Uuid
  approvedByName   String?
  approvedByEmail  String?

  ownershipTransferredAt       DateTime?
  ownershipTransferredByUserId String?   @db.Uuid
  ownershipTransferredByName   String?
  ownershipTransferredByEmail  String?

  archivedAt       DateTime?
  archivedByUserId String?   @db.Uuid
  archivedByName   String?
  archivedByEmail  String?

  deletedAt       DateTime?
  deletedByUserId String?   @db.Uuid
  deletedByName   String?
  deletedByEmail  String?

  workspace                  Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser              User?      @relation("AHSPCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUser             User?      @relation("AHSPApprovedBy", fields: [approvedByUserId], references: [id])
  ownershipTransferredByUser User?      @relation("AHSPOwnershipTransferredBy", fields: [ownershipTransferredByUserId], references: [id])
  archivedByUser             User?      @relation("AHSPArchivedBy", fields: [archivedByUserId], references: [id])
  deletedByUser              User?      @relation("AHSPDeletedBy", fields: [deletedByUserId], references: [id])

  versions   AHSPVersion[]
  snapshots  AHSPSnapshot[]
  importJobs AHSPImportJob[]
  auditLogs  AHSPAuditLog[]

  @@unique([workspaceId, workType, methodType, locationType, methodName])
  @@index([workspaceId])
  @@index([ownershipType])
  @@index([reviewStatus])
  @@index([workspaceId, ownershipType])
  @@index([workspaceId, reviewStatus])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("ahsps")
}

model AHSPVersion {
  id                     String            @id @default(uuid()) @db.Uuid
  ahspId                 String            @db.Uuid
  workspaceId            String?           @db.Uuid // Tenant Scope wajib ada
  versionNumber          Int
  status                 AhspVersionStatus @default(DRAFT)
  effectiveDate          DateTime?
  expiredDate            DateTime?
  regulationReference    String?
  regulationPage         String?
  regulationSection      String?
  outputUnit             String?
  outputUnitDefinitionId String?           @db.Uuid
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  ahsp                   AHSP                    @relation(fields: [ahspId], references: [id], onDelete: Cascade)
  workspace              Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resources              AHSPResource[]
  snapshots              AHSPSnapshot[]
  auditLogs              AHSPAuditLog[]
  BoqItem                BoqItem[]
  projectAhspOccurrences ProjectAhspOccurrence[]
  outputUnitDefinition   UnitDefinition?         @relation("AHSPVersionOutputUnit", fields: [outputUnitDefinitionId], references: [id], onDelete: Restrict)

  @@unique([ahspId, versionNumber])
  @@index([ahspId])
  @@index([workspaceId])
  @@map("ahsp_versions")
}

model AHSPResource {
  id               String   @id @default(uuid()) @db.Uuid
  ahspVersionId    String   @db.Uuid
  resourceId       String // Temporary String (No FK)
  resourceType     String // Temporary String
  coefficient      Decimal  @db.Decimal(18, 6)
  baseUnit         String
  conversionFactor Decimal? @db.Decimal(18, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ahspVersion                    AHSPVersion                     @relation(fields: [ahspVersionId], references: [id], onDelete: Cascade)
  projectAhspResourceResolutions ProjectAhspResourceResolution[]

  @@index([ahspVersionId])
  @@index([resourceId])
  @@map("ahsp_resources")
}

model AHSPSourceDocument {
  id         String     @id @default(uuid()) @db.Uuid
  sourceType SourceType
  name       String
  reference  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@map("ahsp_source_documents")
}

model AHSPImportJob {
  id             String       @id @default(uuid()) @db.Uuid
  ahspId         String?      @db.Uuid
